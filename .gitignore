# Build output and dependency caches — regenerate with `npm --prefix site install && npm --prefix site run build`
site/node_modules/
site/dist/
site/.astro/

# Scratch: probe logs, screenshots, and the local servers' output live here and never belong in the repo
.tmp/
docs/screenshots/

# wrangler's local state: account cache and the tmp dir a Pages deploy stages through. It is machine
# state for a logged-in session, not project source.
.wrangler/

# Editors and OS noise
.DS_Store
Thumbs.db
*.swp
