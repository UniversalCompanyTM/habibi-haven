---
// MenuExplorer.astro — all 243 dishes in the HTML, and a filter that only ever removes things.
//
// The whole menu is rendered by the server. Two reasons, both kept deliberately:
//   * A guest on a slow Nairobi connection, or with JavaScript broken by an extension, still gets the
//     complete menu with prices — which is the only job this page has.
//   * Filtering by hiding is one pass over 243 nodes and cannot produce a blank page from a bug in a
//     render function. Filtering by re-rendering can, and does.
// The cost is 251 kB of JSON that the browser also receives as HTML; gzipped it is ~20 kB and it is
// what makes the live subtotal possible without a round trip. Recorded in docs/ARCHITECTURE.md.
//
// The URL carries the filter, so "show me the bar, cold drinks, under KSh 500" is a link you can send
// to someone. Sorting is per section on purpose: the menu's own order is an argument about what the
// kitchen wants you to see first, and re-sorting the whole page would destroy that to save a scroll.
import menu from "../data/menu.json";
import DishCard from "./DishCard.astro";
import { KNOWN_TAGS } from "../content-schema.mjs";
import { tagLabel } from "../lib/tags.mjs";

const { featuredFirst = false } = Astro.props;
const families = menu.families;
// Only tags that actually appear, so the bar never offers an empty filter. (All eleven do appear;
// tests/run.mjs pins that, and this line means a future tag without items stays unlisted.)
const tags = KNOWN_TAGS.filter((tag) =>
  menu.families.some((f) => f.sections.some((s) => s.items.some((i) => i.tags.includes(tag))))
);
const priceBands = [
  { id: "under-500", label: "Under KSh 500", min: 0, max: 499 },
  { id: "500-1000", label: "KSh 500–1,000", min: 500, max: 1000 },
  { id: "over-1000", label: "Over KSh 1,000", min: 1001, max: null },
];
---

<div class="explorer" data-explorer>
  <div class="explorer__bar" data-bar>
    <div class="explorer__tools">
      <label class="field field--search">
        {/* The word "Search" goes, the magnifier stays: the placeholder already says what goes in here, the
            input carries its own accessible name, and on a phone every character of a label inside the pill
            is a character less of menu the guest can read. */}
        <svg class="field__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M10.7 10.7 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          data-q
          autocomplete="off"
          placeholder="chai, biryani, peach, kids…"
          aria-label={`Search all ${menu.meta.items} dishes and drinks`}
        />
      </label>
      <label class="field field--select">
        <span class="dim" aria-hidden="true">Sort</span>
        <select data-sort aria-label="Sort dishes within each section">
          <option value="menu">As the menu lists</option>
          <option value="cheap">Cheapest first</option>
          <option value="dear">Dearest first</option>
          <option value="az">A–Z</option>
        </select>
      </label>
      {/* The chips are the part of this bar a guest uses twice per visit and looks at once. On a phone the
          two rows below are taller than the search box they belong to and they eat the menu, so under the
          narrow breakpoint the bar ships collapsed and this button is what opens it — with the count of
          filters already applied on its face, so collapsing can never hide a filter that is running. */}
      <button
        type="button"
        class="filters-toggle"
        data-filters
        aria-expanded="true"
        aria-controls="explorer-filters"
        hidden
      >
        Filters
        <span class="filters-toggle__n" data-filters-n hidden>0</span>
      </button>

      {/* Two lines of trailing text, deliberately split: the count is live and belongs beside the control
          that changed it, the provenance is a standing fact about the dataset and is not part of any filter.
          On a phone the provenance goes (the footer states it in full, and every card already says what its
          own picture is) because a sticky bar whose third row is a sentence is the bar that was criticised
          for covering the menu. */}
      <p class="meta explorer__count" aria-live="polite" data-count>
        {menu.meta.items} of {menu.meta.items} items
      </p>
      <p class="meta explorer__src">
        {menu.meta.realPhotos} photographed, {menu.meta.illustratedPhotos} illustrated, {menu.meta.placeholderPhotos}{" "}
        pending upstream
      </p>
    </div>

    <div class="explorer__filters" id="explorer-filters">
      <div class="chips" role="group" aria-label="Filter by price">
        {
          // min/max travel as attributes, so the threshold the label states is the threshold the filter
          // applies. A hard-coded number in the script would be a second source of truth, and the
          // second source is where the goat price went wrong.
          priceBands.map((band) => (
            <button
              type="button"
              data-band={band.id}
              data-min={band.min}
              data-max={band.max ?? ""}
              aria-pressed="false"
            >
              {band.label}
            </button>
          ))
        }
      </div>

      <div class="chips" role="group" aria-label="Filter by tag">
        <button type="button" data-tag="signature" aria-pressed="false" class="chip--teal">Signature only</button>
        {
          tags
            .filter((tag) => tag !== "signature")
            .map((tag) => (
              <button type="button" data-tag={tag} aria-pressed="false">
                {tagLabel(tag)}
              </button>
            ))
        }
        <button type="button" class="chips__reset" data-reset>Clear filters</button>
      </div>
    </div>
  </div>

  <div data-groups>
    {
      families.map((family) => (
        <section class="group" id={family.id} data-group={family.id}>
          <div class="section-head">
            <h2 class="display--h2" data-kin>
              {family.label}
            </h2>
            <span class="meta num">
              {family.sections.reduce((sum, s) => sum + s.count, 0)} items · {family.sections.length} sections
            </span>
          </div>
          {
            family.sections.map((section) => (
              <div class="subgroup" data-subgroup={section.id}>
                <p class="family-mark">
                  {section.label} <span class="dim num">({section.count})</span>
                </p>
                <div class="deck">
                  {section.items.map((item, index) => (
                    <DishCard item={item} priority={featuredFirst && index < 3} />
                  ))}
                </div>
              </div>
            ))
          }
        </section>
      ))
    }

    <p class="empty-note" data-empty hidden>
      Nothing on the menu matches that. The kitchen does list {menu.meta.items} things, so try a shorter word —
      “rice”, “chai”, “cake” — or <button type="button" class="link-arrow" data-reset>clear the filters</button>.
    </p>
  </div>
</div>

<script>
  import menu from "../data/menu.json";
  import { addToTable, getTable, EVENT } from "../lib/table-client.mjs";
  import { wireDishCards } from "../lib/dish-card.mjs";
  import { component } from "../lib/page.mjs";

  // The explorer is the heaviest thing on the site that is not the door: 243 cards, a keyboard shortcut on
  // the window, and a subscription to the table. All of it belongs to the element, so all of it is set up
  // and taken down with the element — which is what makes the `/` handler and the table repaint survive a
  // navigation to /menu and back instead of accumulating one copy per visit.
  component("[data-explorer]", { mount: wire, unmount: (stop) => stop?.() });

  function wire(root: HTMLElement) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-card]"));
    // `data-subgroup`, not `data-section`: a dish card carries data-section="<Breakfast>" as metadata, so
    // querying [data-section] returned 41 sections AND 243 cards, and the section pass below — which asks
    // each node whether it contains a visible card — answered "no" for every card and hid all of them. The
    // page then printed "Showing all 243 items" over an empty menu, because the count was computed in the
    // pass before the one that deleted the work. Two meanings in one attribute name.
    // The family containers had the same collision waiting: they were tagged data-family while every card
    // also carries data-family="<morning>" as metadata, so [data-family] was 6 sections or 249 nodes
    // depending on who asked. Containers now own data-group / data-subgroup; data-family and data-section
    // on a card mean only "which family / section does this dish belong to".
    const subgroups = Array.from(root.querySelectorAll<HTMLElement>("[data-subgroup]"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-group]"));
    // Capture the kitchen's sequence before the first sort moves any nodes. A later "As the menu lists"
    // selection must restore these exact elements; returning early would silently keep the previous order.
    const menuOrder = new Map<HTMLElement, HTMLElement[]>(subgroups.map((sub) => [
      sub,
      Array.from(sub.querySelectorAll<HTMLElement>("[data-card]")),
    ]));
    const search = root.querySelector<HTMLInputElement>("[data-q]")!;
    const sort = root.querySelector<HTMLSelectElement>("[data-sort]")!;
    const live = root.querySelector<HTMLElement>("[data-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;
    const tagButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tag]"));
    const bandButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-band]"));
    const bar = root.querySelector<HTMLElement>("[data-bar]");
    const panel = root.querySelector<HTMLElement>("#explorer-filters");
    const fold = root.querySelector<HTMLButtonElement>("[data-filters]");
    const foldCount = root.querySelector<HTMLElement>("[data-filters-n]");

    const state = {
      q: "",
      tags: new Set<string>(),
      band: null as string | null,
      sort: "menu",
      room: decodeURIComponent(location.hash.replace("#", "")) || null,
    };

    // A filter link from someone else's screen: /menu?q=chai&tag=chai,cold&band=under-500
    const params = new URLSearchParams(location.search);
    if (params.get("q")) state.q = params.get("q")!.toLowerCase();
    if (params.get("tag")) params.get("tag")!.split(",").filter(Boolean).forEach((t) => state.tags.add(t));
    if (params.get("band")) state.band = params.get("band");
    if (params.get("sort")) state.sort = params.get("sort");

    // The thresholds come off the buttons the server wrote, so the label and the filter cannot drift.
    const bandMatches = (price: number) => {
      const button = bandButtons.find((b) => b.dataset.band === state.band);
      if (!button) return true;
      const min = Number(button.dataset.min ?? 0);
      const maxRaw = button.dataset.max ?? "";
      const max = maxRaw === "" ? Infinity : Number(maxRaw);
      return price >= min && price <= max;
    };

    const matches = (card: HTMLElement) => {
      const name = card.dataset.name ?? "";
      const desc = card.dataset.desc ?? "";
      const tagsOn = (card.dataset.tags ?? "").split(/\s+/).filter(Boolean);
      const price = Number(card.dataset.price ?? 0);
      if (state.q && !name.includes(state.q) && !desc.includes(state.q)) return false;
      if (state.band && !bandMatches(price)) return false;
      for (const t of state.tags) if (!tagsOn.includes(t)) return false;
      return true;
    };

    const syncControls = () => {
      // `search.value` is deliberately not written here: apply() runs on every keystroke, and putting
      // the trimmed, lower-cased query back into the box would eat the guest's spaces as they type.
      sort.value = state.sort;
      tagButtons.forEach((b) => b.setAttribute("aria-pressed", String(state.tags.has(b.dataset.tag ?? ""))));
      bandButtons.forEach((b) => b.setAttribute("aria-pressed", String(state.band === b.dataset.band)));
    };

    const writeUrl = () => {
      // Start from the live query so table commits and room links survive filter/sort changes.
      const p = new URLSearchParams(location.search);
      if (state.q) p.set("q", state.q);
      else p.delete("q");
      if (state.tags.size) p.set("tag", [...state.tags].join(","));
      else p.delete("tag");
      if (state.band) p.set("band", state.band);
      else p.delete("band");
      if (state.sort !== "menu") p.set("sort", state.sort);
      else p.delete("sort");
      const qs = p.toString();
      const hash = state.room ? `#${state.room}` : "";
      history.replaceState(null, "", qs ? `?${qs}${hash}` : `${location.pathname}${hash}`);
    };

    const sortDeck = (deck: HTMLElement) => {
      const items = Array.from(deck.querySelectorAll<HTMLElement>("[data-card]"));
      if (state.sort === "menu") {
        menuOrder.get(deck)?.forEach((node) => deck.append(node));
        return;
      }
      const by = {
        cheap: (a: number, b: number) => a - b,
        dear: (a: number, b: number) => b - a,
        az: (a: string, b: string) => a.localeCompare(b),
      }[state.sort];
      if (!by) return;
      const ranked = [...items].sort((a, b) =>
        state.sort === "az"
          ? by(a.dataset.name ?? "", b.dataset.name ?? "")
          : by(Number(a.dataset.price ?? 0), Number(b.dataset.price ?? 0))
      );
      ranked.forEach((node) => deck.append(node));
    };

    let visibleCount = cards.length;

    const apply = () => {
      visibleCount = 0;
      for (const card of cards) {
        const show = matches(card);
        card.hidden = !show;
        if (show) visibleCount += 1;
      }
      for (const sub of subgroups) {
        const any = Array.from(sub.querySelectorAll<HTMLElement>("[data-card]")).some((c) => !c.hidden);
        sub.hidden = !any;
      }
      for (const group of groups) {
        const any = Array.from(group.querySelectorAll<HTMLElement>("[data-subgroup]")).some((s) => !s.hidden);
        group.hidden = !any;
      }
      subgroups.forEach((sub) => {
        const deck = sub.querySelector<HTMLElement>(".deck");
        if (deck) sortDeck(deck);
      });
      empty.hidden = visibleCount > 0;
      const tagWords = tagButtons
        .filter((b) => state.tags.has(b.dataset.tag ?? ""))
        .map((b) => (b.textContent ?? "").trim().replace(" only", "").toLowerCase());
      live.textContent =
        visibleCount === cards.length
          ? // Byte-for-byte what the server rendered, so the line cannot flicker on hydration (item 17).
            `${cards.length} of ${cards.length} items`
          : `${visibleCount} of ${cards.length}${state.q ? ` matching “${state.q}”` : ""}${
              tagWords.length ? ` · ${tagWords.join(" + ")}` : ""
            }${state.band ? ` · ${bandButtons.find((b) => b.dataset.band === state.band)?.textContent ?? ""}` : ""}.`;
      paintBadge();
      syncControls();
      writeUrl();
      // The live count and active-filter badge share the sticky tools row. Either can change its wrapping,
      // so the offset used by cards and deep links has to be measured from the finished state, not the
      // previous filter's rectangle.
      measureBar();
      document.dispatchEvent(new CustomEvent("hh:prep"));
    };

    /* ---------------- the bar, folded on a phone ----------------
       Two rows of chips under a search box read as a toolbar on a desktop and as half a viewport on a
       390 px phone, and a sticky half-viewport toolbar is the thing that "blocks the other content". So
       below the wide breakpoint the chips fold behind a button. What keeps that honest is the count on the
       button's face: a filter that is running can never be folded away out of sight, and the live line
       beside it keeps naming the same filter. */
    const narrow = matchMedia("(max-width: 62rem)");
    let chipsOpen = false;

    const activeCount = () => state.tags.size + (state.band ? 1 : 0);

    const paintBadge = () => {
      if (!foldCount) return;
      const n = activeCount();
      foldCount.hidden = n === 0;
      foldCount.textContent = String(n);
    };

    const measureBar = () => {
      if (bar) root.style.setProperty("--bar-h", `${Math.round(bar.getBoundingClientRect().height)}px`);
    };

    const paintFold = () => {
      if (!fold || !panel) return;
      const wide = !narrow.matches;
      fold.hidden = wide;
      panel.hidden = wide ? false : !chipsOpen;
      fold.setAttribute("aria-expanded", String(wide || chipsOpen));
      // Badge first: revealing the active-filter count can widen the button and add a tools row.
      paintBadge();
      measureBar();
    };

    fold?.addEventListener("click", () => {
      chipsOpen = !chipsOpen;
      paintFold();
    });
    if (narrow.addEventListener) narrow.addEventListener("change", paintFold);
    addEventListener("resize", paintFold, { passive: true });

    // One-time: a query that arrived in the address goes into the box, so the screen and the URL agree.
    search.value = state.q;
    sort.value = state.sort;

    search.addEventListener("input", () => {
      state.q = search.value.trim().toLowerCase();
      apply();
    });
    search.addEventListener("search", () => {
      state.q = search.value.trim().toLowerCase();
      apply();
    });
    sort.addEventListener("change", () => {
      state.sort = sort.value;
      apply();
    });
    tagButtons.forEach((button) =>
      button.addEventListener("click", () => {
        const tag = button.dataset.tag ?? "";
        if (state.tags.has(tag)) state.tags.delete(tag);
        else state.tags.add(tag);
        apply();
      })
    );
    bandButtons.forEach((button) =>
      button.addEventListener("click", () => {
        const band = button.dataset.band ?? null;
        state.band = state.band === band ? null : band;
        apply();
      })
    );
    Array.from(root.querySelectorAll("[data-reset]")).forEach((node) =>
      node.addEventListener("click", () => {
        state.q = "";
        state.tags.clear();
        state.band = null;
        // Cleared here and deliberately not in syncControls(): "Clear filters" is the guest asking for the
        // whole menu back, and a search box still holding “zzzqqq” above 243 visible dishes is the page
        // describing a filter it is not applying. During typing the box is the guest's property; on reset it
        // is the guest's instruction, and the instruction is "empty".
        search.value = "";
        apply();
      })
    );

    // `/` to search, Escape to let go of it — the two shortcuts a guest on a laptop expects.
    const onKey = (event: KeyboardEvent) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((event.target as HTMLElement)?.tagName ?? "");
      if (event.key === "/" && !typing) {
        event.preventDefault();
        search.focus();
      } else if (event.key === "Escape" && typing && event.target === search) {
        search.value = "";
        state.q = "";
        apply();
        search.blur();
      }
    };
    addEventListener("keydown", onKey);

    /* ---------------- the table, from here ---------------- */

    // Homepage and Menu share this painter and delegated Add handler. It restores stored side choices,
    // reports multiple selected sides honestly, and returns one teardown for both of its listeners.
    const stopDishCards = wireDishCards(root, { target: document, event: EVENT, getTable, addToTable });

    // Always run once: a query, tag or band can arrive in the address, and the page has to agree with
    // the URL it was opened with even when nobody touched a control.
    paintFold();
    apply();

    if (state.room) {
      const room = state.room;
      const target = groups.find((g) => g.dataset.group === room) ?? document.getElementById(room);
      if (target) {
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        requestAnimationFrame(() => target.scrollIntoView({ block: "start", behavior: calm ? "auto" : "smooth" }));
      }
    }

    // Only the two listeners that live outside the explorer need releasing. Everything else is bound to a
    // control inside `root` — the search box, the tag buttons, the delegated click on the grid — and goes
    // away with the node. The window keydown and the table subscription do not, and a second copy of
    // either would mean `/` focusing a search box on a page that has left it behind.
    return () => {
      removeEventListener("keydown", onKey);
      removeEventListener("resize", paintFold);
      if (narrow.removeEventListener) narrow.removeEventListener("change", paintFold);
      stopDishCards();
    };
  }
</script>
