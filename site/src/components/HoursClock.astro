---
// HoursClock.astro — the day, as a dial.
//
// This is the light rig turned into a control. Dragging it rewrites `--hour`, `--night` and `--sun` on
// the document element through lib/rig-client.mjs — the only writer — and everything else follows from
// there: CSS interpolates the palette, the atmosphere layer moves its sun, the hero photograph changes
// how it is lit, and the WebGL door is handed the same numbers. Nothing in this file computes what
// 20:30 looks like; it renders whatever `rigFor()` answered and repaints from the `hh:hour` event, so
// the labels and the room can never be showing different times.
//
// A19 took the half-hour detent out. The control runs 00:00 → 24:00 with `step="any"`, because a sun
// that arrives in twenty-eight jumps is a slideshow, and the owner asked for a room that shifts "like
// the sun over the sky" — every second, unnoticed. The ruler underneath is positioned by hour rather
// than spaced by flexbox, so a label at 06:30 sits over the point on the track that *is* 06:30.
//
// The dial is not a booking control. It does not touch the table and the copy says so, because there
// is no availability data upstream to check a reservation against.
import { CLOSE_LABEL, DIAL_MAX, DIAL_MIN, OPEN_LABEL, hourToLabel, nairobiHourFloat, nextChange, rigFor } from "../lib/hours.mjs";

// `name` makes the id unique per call site. `Astro.uid` does not exist in Astro 5.18 — it is an
// island-HMR prop, not context — so every dial used to render `id="dial-undefined"`, and the home
// page mounts two of them: duplicate ids, and the second dial's label pointed at the first one.
const { minimal = false, name = "day" } = Astro.props;
const dialId = `dial-${name}`;
const noteId = `dial-note-${name}`;

// The same build-time hour Base.astro writes onto <html>, from the same function — so the server HTML
// and this component agree without either one hardcoding a time.
const rig = rigFor(nairobiHourFloat());
const countdown = nextChange();

// Marks the guest can actually orient on: midnight, the hour of record opening the kitchen, the middle
// of the day, golden hour, and the closing minute. The compact variant keeps the two ends and noon.
const STOP_HOURS = minimal ? [DIAL_MIN, 12, DIAL_MAX] : [DIAL_MIN, 6.5, 12, 17.5, 23, DIAL_MAX];
const stops = STOP_HOURS.map((hour) => ({
  hour,
  label: hourToLabel(hour),
  name: rigFor(hour).name,
  // The track spans DIAL_MIN→DIAL_MAX, so an hour's place on it is a plain ratio. Written as a
  // custom property rather than a hard-coded `left`, so the ruler and the domain cannot drift if the
  // dial is ever narrowed or widened.
  pct: ((hour - DIAL_MIN) / (DIAL_MAX - DIAL_MIN)) * 100,
}));
---

<div class:list={['dial', { 'dial--minimal': minimal }]} data-dial>
  <div class="dial__now">
    <time datetime={rig.label} data-clock>{rig.label}</time>
    <p data-phase>{rig.name}</p>
    <span class="chip" class:list={[{ "chip--amber": !rig.open }]} data-state>
      {rig.open ? "Open" : "Closed"}
    </span>
  </div>

  <p class="meta" data-line>{rig.line}</p>

  <div class="dial__track" data-track>
    <label class="sr-only" for={dialId}>Hour of the day in Nairobi</label>
    <input
      type="range"
      id={dialId}
      min={String(DIAL_MIN)}
      max={String(DIAL_MAX)}
      step="any"
      value={rig.hour}
      data-dial-input
      aria-describedby={minimal ? null : noteId}
    />
  </div>

  <div class="dial__ruler" aria-hidden="true">
    {
      stops.map((s) => (
        <span data-phase-stop data-hour={s.hour} style={`--p:${s.pct.toFixed(3)}%`}>
          {s.label}
          <em data-stop-name>{s.name}</em>
        </span>
      ))
    }
  </div>

  {
    minimal ? null : (
      <div class="row-wrap">
        <button type="button" class="btn btn--small btn--ghost" data-dial-now>Back to now</button>
        <button type="button" class="btn btn--small btn--ghost" data-dial-play aria-pressed="false">
          Watch the day go
        </button>
        <span class="chip" data-countdown title={countdown.kind === "closes" ? "Until the kitchen closes" : "Until it opens"}>
          {countdown.label}
        </span>
      </div>
    )
  }

  <p class="meta dial__note" id={noteId}>
    The dial runs the whole day, continuously — no half-hour jumps. {OPEN_LABEL}–{CLOSE_LABEL} are the
    hours of record, and the chip says which side of them you are on. It changes the light in the room,
    not the menu, and it books nothing.
  </p>
</div>

<script>
  import { applyHour, currentHour, HOUR_EVENT, releaseToNow } from "../lib/rig-client.mjs";
  // DIAL_MIN/DIAL_MAX are used by the playback wrap below. The frontmatter has its own import list, and
  // adding them there is what made this block throw `DIAL_MAX is not defined` on the first tick of
  // "Watch the day go" while `astro build` reported success — a script block resolves names at click
  // time, not build time. Both lists have to be edited together.
  import { DIAL_MAX, DIAL_MIN, nairobiHourFloat, nextChange, rigFor } from "../lib/hours.mjs";
  import { collection } from "../lib/page.mjs";

  // A full day, played in 26 seconds. Slower and nobody reads it as motion; faster and the room strobes.
  const DAY_MS = 26_000;
  // Arrow keys on a `step="any"` range move 1% of the domain — 0.24 h, about fourteen minutes, which is
  // a number no keyboard guest would choose. These are the steps a person actually means.
  const KEY_STEP = 0.25; // 15 minutes
  const PAGE_STEP = 1; // an hour

  // Every dial on the page gets wired, because a hero carries a small one and the rig section a full
  // one, and a `document.querySelector` would silently leave the second dead. `collection` rather than a
  // `forEach` at module scope because the module runs once: after a navigation the dials are new elements,
  // and a second `forEach(wire)` over the document would bind the surviving ones twice — two playback
  // loops, two countdowns, one handle answering to both.
  collection("[data-dial]", { mount: wire, unmount: (stop) => stop?.() });

  function wire(dial: HTMLElement) {
    const input = dial.querySelector<HTMLInputElement>("[data-dial-input]");
    const clock = dial.querySelector<HTMLElement>("[data-clock]");
    const phase = dial.querySelector<HTMLElement>("[data-phase]");
    const line = dial.querySelector<HTMLElement>("[data-line]");
    const state = dial.querySelector<HTMLElement>("[data-state]");
    const stopNodes = Array.from(dial.querySelectorAll<HTMLElement>("[data-phase-stop]"));
    const countdownEl = dial.querySelector<HTMLElement>("[data-countdown]");

    if (!input) return;

    // Wherever the build left the room is where the handle belongs, even if a script dialled it first.
    input.value = String(currentHour());

    const paint = (hour: number) => {
      const r = rigFor(hour);
      input.value = String(r.hour); // the play loop advances from here, so it has to move
      // The track's fill is the day so far, drawn from the handle's own position rather than a second
      // number that could disagree with it.
      dial.style.setProperty("--dial-p", `${((r.hour - DIAL_MIN) / (DIAL_MAX - DIAL_MIN)) * 100}%`);
      if (clock) {
        clock.textContent = r.label;
        clock.setAttribute("datetime", r.label);
      }
      if (phase) phase.textContent = r.name;
      if (line) line.textContent = r.line;
      if (state) {
        state.textContent = r.open ? "Open" : "Closed";
        state.classList.toggle("chip--amber", !r.open);
      }
      // The last stop at or before the dialled hour is the one the room is currently in.
      let active = 0;
      stopNodes.forEach((node, i) => {
        if (r.hour >= Number(node.dataset.hour ?? 0)) active = i;
      });
      stopNodes.forEach((node, i) => {
        node.classList.toggle("is-active", i === active);
        const name = node.querySelector<HTMLElement>("[data-stop-name]");
        if (name) name.textContent = i === active ? r.name : "";
      });
    };

    function tickCountdown() {
      if (!countdownEl) return;
      const next = nextChange();
      countdownEl.textContent = next.label;
      countdownEl.title = next.kind === "closes" ? "Until the kitchen closes" : "Until it opens";
    }

    // One listener. The handle, the labels and the countdown all repaint from the event the writer
    // fired, so there is no second copy of this rendering to drift out of step with the first.
    const onHour = (event: Event) => paint((event as CustomEvent).detail.hour);
    document.addEventListener(HOUR_EVENT, onHour);
    paint(Number(input.value));
    tickCountdown();

    input.addEventListener("input", () => {
      stop();
      applyHour(Number(input.value));
    });

    // Keyboard: 15 minutes per arrow, an hour per Page Up/Down, the ends per Home/End. Without this a
    // keyboard guest moves the whole room by fourteen-minute shuffles and cannot reach 00:00 at all.
    input.addEventListener("keydown", (event: KeyboardEvent) => {
      const from = Number(input.value);
      let to: number | null = null;
      if (event.key === "ArrowLeft" || event.key === "ArrowDown") to = from - KEY_STEP;
      else if (event.key === "ArrowRight" || event.key === "ArrowUp") to = from + KEY_STEP;
      else if (event.key === "PageDown") to = from - PAGE_STEP;
      else if (event.key === "PageUp") to = from + PAGE_STEP;
      else if (event.key === "Home") to = DIAL_MIN;
      else if (event.key === "End") to = DIAL_MAX;
      if (to === null) return;
      event.preventDefault();
      stop();
      // The domain wraps rather than sticks: 24:00 and 00:00 are the same instant, and a guest who
      // presses Right at midnight should find themselves at 00:15, not pinned at one end.
      const wrapped = (to + 24) % 24;
      applyHour(to > DIAL_MAX && from >= DIAL_MAX - KEY_STEP ? wrapped : Math.max(DIAL_MIN, Math.min(DIAL_MAX, to)));
    });

    dial.querySelector("[data-dial-now]")?.addEventListener("click", () => {
      stop();
      // The wall clock, not the show, and to the second. At 02:00 the handle goes to 02:00, the chip
      // reads Closed and the countdown says when it opens — the hour is never rounded up to opening
      // time to look better. This also hands the room back to the ambient drift, which only runs while
      // nobody has dialled it.
      releaseToNow();
      tickCountdown();
    });

    /* The day, played. Same writer as the slider, so the room and the handle cannot disagree — but
       frame-accurate rather than stepped: the old loop applied +0.5 h every 1.1 s, which is exactly the
       detent this dial no longer has, and it showed. Position now comes from elapsed time, so the
       smoothness survives a slow frame instead of dropping an hour. */
    let raf = 0;
    let at = 0;
    let last = 0;
    const play = dial.querySelector<HTMLButtonElement>("[data-dial-play]");

    function step(now: number) {
      const delta = last ? now - last : 0;
      last = now;
      at = (at + (delta / DAY_MS) * (DIAL_MAX - DIAL_MIN)) % (DIAL_MAX - DIAL_MIN);
      applyHour(DIAL_MIN + at);
      raf = requestAnimationFrame(step);
    }

    function stop() {
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
      if (play) {
        play.setAttribute("aria-pressed", "false");
        play.textContent = "Watch the day go";
      }
    }

    play?.addEventListener("click", () => {
      if (raf) {
        stop();
        return;
      }
      play.setAttribute("aria-pressed", "true");
      play.textContent = "Stop";
      // Continue from wherever the handle is rather than jumping to midnight, so pressing play never
      // moves the room the guest is looking at.
      at = Math.max(0, Math.min(DIAL_MAX - DIAL_MIN, Number(input.value) - DIAL_MIN));
      raf = requestAnimationFrame(step);
    });

    // A looping timer in a hidden tab is nobody's idea of motion, and reduced-motion gets no autoplay.
    const onHide = () => {
      if (document.hidden) stop();
    };
    addEventListener("pagehide", stop);
    document.addEventListener("visibilitychange", onHide);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) play?.setAttribute("hidden", "");

    // The countdown is the wall clock; the dial is the show. They are allowed to disagree, and saying
    // which is which is the whole point of putting both on the panel.
    const countdown = setInterval(tickCountdown, 60_000);

    // Everything with a teardown cost is returned rather than left running: this dial's hour listener,
    // its key handler and two timers. A swapped-out dial keeps nothing; a dialled-back-to home page gets
    // one fresh set per live dial, which is the property `collection` exists to hold.
    return () => {
      stop();
      document.removeEventListener(HOUR_EVENT, onHour);
      removeEventListener("pagehide", stop);
      document.removeEventListener("visibilitychange", onHide);
      clearInterval(countdown);
    };
  }
</script>
