---
// Atmosphere.astro — the sky behind the site, drawn on the GPU.
//
// This is the one layer that answers to `--sun` continuously. Everything else on the page reacts to the
// clock through `color-mix(… var(--night))` in CSS, which is correct and cheap but only repaints when a
// property changes; the room's *light* deserves to move every frame, and a stylesheet cannot animate a
// gradient's centre at sixty frames without animating the whole document. So this is a single fixed
// full-viewport canvas running one fragment shader, and it is deliberately the only place on the site
// where a colour is computed rather than declared.
//
// What it may not do:
//   · hold its own palette — every hue is sampled off `:root` through scenes/rig.js, the same reader the
//     WebGL door uses, so the sky and the stylesheet cannot drift apart;
//   · heat a phone — quarter resolution, capped frame rate, paused when the tab is hidden, and switched
//     off entirely for reduced-motion, save-data, and machines that say they have fewer than four cores;
//   · exist without a fallback — if WebGL context creation fails, the element is left in the DOM with
//     `data-css` and the gradient below paints instead. The page looks like the page, not like an error.
import { nairobiHourFloat, nightAmount, sunAmount } from "../lib/hours.mjs";

// Build-time values, so the server HTML already carries the hour in its style attribute and a shader-less
// first paint is the right colour rather than a default that then snaps.
const hour = nairobiHourFloat();
const sun = sunAmount(hour);
---

<div class="atmosphere" data-atmosphere aria-hidden="true" style={`--a-sun: ${sun.toFixed(4)}; --a-hour: ${hour.toFixed(4)}`}>
  // `aria-hidden` on the wrapper already hides this subtree, but the canvas repeats it because the rule the
  // build audits is the one that survives a refactor: "no canvas in the shipped document is readable by an
  // assistive tech". A gate that has to go looking for a hidden ancestor is a gate that passes the day
  // somebody moves the layer into a div that has to be announced. Same for `alt=""` on a decorative image.
  <canvas data-atmosphere-canvas aria-hidden="true"></canvas>
</div>

<style>
  .atmosphere {
    position: fixed;
    inset: 0;
    /* Between the CSS wash on body::before (-2) and the content (auto), so it reads as light in the room
       rather than as a picture on it. */
    z-index: -1;
    pointer-events: none;
    /* The CSS stand-in: two soft blooms whose opacity is driven by the same --sun the shader receives, so
       even without WebGL the sky gets brighter at noon. */
    background:
      radial-gradient(
        70% 55% at calc(8% + var(--a-hour, 19) / 24 * 84%) 18%,
        color-mix(in oklab, var(--chai) calc(var(--a-sun, 0) * 26%), transparent),
        transparent 62%
      ),
      radial-gradient(
        120% 90% at 50% 118%,
        color-mix(in oklab, var(--teal) 14%, transparent),
        transparent 70%
      );
    opacity: 0.9;
  }

  .atmosphere canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  /* Only fade the shader in once it has actually drawn a frame, and only then hide the gradient —
     otherwise a slow context creation shows a black rectangle over the room. */
  .atmosphere[data-live] canvas {
    opacity: 1;
  }

  .atmosphere[data-live] {
    background: none;
  }
</style>

<script>
  import { HOUR_EVENT } from "../lib/rig-client.mjs";
  import { readClock, readPalette } from "../scenes/rig.js";
  import { component } from "../lib/page.mjs";

  // Quarter resolution. The shader is one low-frequency gradient field; anything above this is paying for
  // pixels the eye cannot resolve in a background layer, on battery, in someone's pocket.
  const SCALE = 0.28;
  const FPS = 24;

  const VERT = `attribute vec2 p; void main(){ gl_Position = vec4(p,0.,1.); }`;

  // fbm over four octaves of value noise, warped by a second sample so the bands fold like weather rather
  // than sliding like a screensaver. The palette arrives as uniforms; nothing here is a hard-coded colour.
  const FRAG = `
precision mediump float;
uniform vec2 u_res; uniform float u_time; uniform float u_sun; uniform float u_night;
uniform vec3 u_teal, u_leaf, u_lagoon, u_amber, u_ember, u_hibiscus, u_chai, u_bg;
float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float n(vec2 p){
  vec2 i = floor(p), f = fract(p);
  float a = h(i), b = h(i + vec2(1.,0.)), c = h(i + vec2(0.,1.)), d = h(i + vec2(1.,1.));
  vec2 u = f * f * (3. - 2. * f);
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p){
  float v = 0., a = 0.5;
  for (int i = 0; i < 4; i++){ v += a * n(p); p = p * 2.03 + vec2(1.7, 9.2); a *= 0.5; }
  return v;
}
void main(){
  vec2 uv = gl_FragCoord.xy / u_res;
  vec2 q = uv * vec2(u_res.x / u_res.y, 1.);
  float t = u_time * 0.022;

  // Weather: two warping fields, one slow, one slower, mixed into a band structure that leans horizontal
  // because it is reading as sky and light spill, not as lava.
  float w = fbm(q * 1.5 + vec2(t, -t * 0.6));
  float bands = fbm(q * 2.2 + vec2(w * 1.4, t * 0.35));
  float veil = smoothstep(0.28, 0.92, bands);

  // The sun on an arc: 06:30 rises at the left edge, 18:30 sets at the right, and the glow is a bloom
  // rather than a disc because this is ambient light, not an illustration.
  float day = clamp((u_night < 0.5 ? 1. - u_night * 2. : 0.), 0., 1.);
  float arc = clamp((uv.x - 0.06) / 0.88, 0., 1.);
  float lift = sin(arc * 3.14159) * 0.62 + 0.2;
  vec2 sunPos = vec2(arc, lift);
  float d = distance(vec2(q.x, uv.y), vec2(q.x * (u_res.y / u_res.x) * 0. + sunPos.x, sunPos.y));
  float bloom = pow(max(0., 1. - d * 1.45), 3.2);

  // Dusk and dawn get the warm end of the palette; midday is chai and lagoon; night is teal over bg.
  vec3 warm = mix(u_amber, u_ember, smoothstep(0.35, 0.85, bands));
  vec3 cool = mix(u_teal, u_lagoon, 0.35 + 0.4 * w);
  vec3 fresh = mix(u_leaf, u_hibiscus, smoothstep(0.45, 0.95, w));
  vec3 sky = mix(cool, warm, pow(1. - abs(uv.y - 0.42) * 1.35, 2.2) * 0.7);
  sky = mix(sky, fresh, 0.12 + 0.1 * veil);
  vec3 dayLight = mix(u_chai, u_lagoon, 0.3);

  vec3 col = u_bg;
  col += sky * veil * (0.16 + 0.3 * u_night);
  col = mix(col, dayLight, day * 0.16 * (0.4 + veil));
  col += warm * bloom * (0.1 + 0.34 * day);
  col += cool * bloom * 0.06;

  // Grain, tied to the pixel not the time, so it behaves like film rather than like snow on a dead channel.
  float g = h(gl_FragCoord.xy + vec2(3.0, 7.0)) - 0.5;
  col += g * 0.018;

  gl_FragColor = vec4(col, 1.0);
}`;

  component("[data-atmosphere]", { mount: wire, unmount: (stop) => stop?.() });

  function wire(root: HTMLElement) {
    const canvas = root.querySelector("canvas");
    if (!canvas) return;

    // The gates, cheapest first. Each one of these means "this machine or this person asked us not to
    // run a shader", and the answer is the CSS layer, which is already painted behind this one.
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const conn = (navigator as any).connection;
    const saver = conn?.saveData === true || /(^|-)2g$/.test(conn?.effectiveType ?? "");
    if (calm || saver || (navigator.hardwareConcurrency ?? 8) < 4) return;

    let gl: WebGLRenderingContext | null = null;
    try {
      gl = (canvas as HTMLCanvasElement).getContext("webgl", {
        alpha: false,
        antialias: false,
        depth: false,
        powerPreference: "low-power",
      }) as WebGLRenderingContext | null;
    } catch {
      gl = null;
    }
    if (!gl) return;

    const compile = (type: number, src: string) => {
      const sh = gl!.createShader(type)!;
      gl!.shaderSource(sh, src);
      gl!.compileShader(sh);
      if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) {
        console.warn("hh:atmosphere — shader refused:", gl!.getShaderInfoLog(sh));
        return null;
      }
      return sh;
    };

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    // One quad, two triangles, five vertices' worth of nothing. All the work is in the fragment stage.
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const U = (name: string) => gl!.getUniformLocation(prog, name);
    const u = {
      res: U("u_res"),
      time: U("u_time"),
      sun: U("u_sun"),
      night: U("u_night"),
      teal: U("u_teal"),
      leaf: U("u_leaf"),
      lagoon: U("u_lagoon"),
      amber: U("u_amber"),
      ember: U("u_ember"),
      hibiscus: U("u_hibiscus"),
      chai: U("u_chai"),
      bg: U("u_bg"),
    };

    /** 0–255 bytes from rig.js → 0–1 floats for the GPU. Read twice: at mount and on each hh:hour. */
    let pal = readPalette();
    const put = (name: string, key: keyof typeof pal) => {
      const c = pal[key] as number[];
      gl!.uniform3f(u[name as keyof typeof u] as WebGLUniformLocation, c[0] / 255, c[1] / 255, c[2] / 255);
    };

    const sendPalette = () => {
      pal = readPalette();
      put("teal", "teal");
      put("leaf", "leaf");
      put("lagoon", "lagoon");
      put("amber", "amber");
      put("ember", "ember");
      put("hibiscus", "hibiscus");
      put("chai", "chai");
      put("bg", "bg0");
    };
    sendPalette();

    const resize = () => {
      const w = Math.max(1, Math.round(innerWidth * SCALE));
      const h = Math.max(1, Math.round(innerHeight * SCALE));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl!.viewport(0, 0, w, h);
      }
    };
    resize();

    const started = performance.now();
    let raf = 0;
    let lastDraw = 0;
    let clock = readClock();

    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      // A capped frame rate on a background gradient is invisible; 60 fps of it is a fan on somebody's
      // laptop. Everything above this line stays responsive because it is event-driven, not frame-driven.
      if (now - lastDraw < 1000 / FPS) return;
      lastDraw = now;
      if (document.hidden) return;
      // The sun value is read from the document, not recomputed here, so the shader and the palette are
      // the same clock. getComputedStyle on two registered numbers once a frame is cheap; and the
      // interpolation that makes it move per frame happens in CSS.
      clock = readClock();
      root.style.setProperty("--a-sun", (1 - clock.night).toFixed(4));
      root.style.setProperty("--a-hour", clock.hour.toFixed(4));
      gl!.uniform2f(u.res, canvas.width, canvas.height);
      gl!.uniform1f(u.time, (now - started) / 1000);
      gl!.uniform1f(u.sun, 1 - clock.night);
      gl!.uniform1f(u.night, clock.night);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      if (!root.dataset.live) root.dataset.live = "1";
    };
    raf = requestAnimationFrame(draw);

    const onResize = () => resize();
    addEventListener("resize", onResize, { passive: true });
    // Palette changes are hour changes, and there is exactly one event for that.
    const onHour = () => sendPalette();
    document.addEventListener(HOUR_EVENT, onHour);

    // A context loss is not an error state on this page: the CSS layer underneath is complete on its own,
    // so the correct response is to stop pretending we have a GPU and let the gradient carry it.
    const onLost = (event: Event) => {
      event.preventDefault();
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      delete root.dataset.live;
    };
    canvas.addEventListener("webglcontextlost", onLost);

    return () => {
      if (raf) cancelAnimationFrame(raf);
      removeEventListener("resize", onResize);
      document.removeEventListener(HOUR_EVENT, onHour);
      canvas.removeEventListener("webglcontextlost", onLost);
      // Free the driver's resources explicitly: the router keeps one document, and a shader program per
      // navigation would be a leak no garbage collector here can help with.
      gl!.deleteProgram(prog);
      gl!.deleteBuffer(buf);
      gl!.deleteShader(vs);
      gl!.deleteShader(fs);
      gl!.getExtension("WEBGL_lose_context")?.loseContext();
    };
  }
</script>
