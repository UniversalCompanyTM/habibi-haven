---
// TableBuilder.astro — "set your table", the centre of the concept.
//
// What it is: a wish-list you can send. What it is not: a booking. There is no availability data
// upstream and no kitchen system to write into, so nothing here can promise a table — the handoff is
// a WhatsApp message the guest sends themselves, with the exact lines, the exact prices, and a link
// back to this same table. That distinction is written into the copy twice, because a configurator
// that looks like a checkout and isn't one is how a restaurant gets angry phone calls.
//
// The maths is all in lib/table.mjs and is covered by tests/run.mjs; the state is in
// lib/table-client.mjs. This file only draws, and re-draws when "hh:table" fires — so a card added on
// /menu and a row changed here go through the same code path.
import menu from "../data/menu.json";
import { money, partyAdvice, signatureItems, totals as computeTotals } from "../lib/table.mjs";
import { hourToLabel, OPEN_MINUTES, CLOSE_MINUTES, nextChange, nairobiMinutes } from "../lib/hours.mjs";
import { getTable } from "../lib/table-client.mjs";

const f = menu.meta.facts;
const signatures = signatureItems(menu);
const origin = Astro.site ?? new URL("https://habibi-haven.example");

// Half-hour slots across the day they are actually open. The last one is 22:30 rather than 23:00:
// asking a guest to arrive at the minute the kitchen closes would be a rude interface.
const slots: string[] = [];
for (let m = OPEN_MINUTES; m <= CLOSE_MINUTES - 30; m += 30) slots.push(hourToLabel(m));
const uniqueSlots = [...new Set(slots)];

const initialTable = getTable();
const initial = computeTotals(menu, initialTable);
const change = nextChange();
---

<div class="builder" data-builder data-origin={origin.href} data-phone={f.whatsapp}>
  <div class="stack-lg">
    <section class="panel" style="padding:1.1rem">
      <h2 class="display--h3" id="party-label">How many of you</h2>
      <div class="party" role="group" aria-labelledby="party-label">
        <div class="stepper">
          <button type="button" data-party="-1" aria-label="One guest fewer">−</button>
          <output class="num" data-party-count aria-live="polite">{initialTable.party}</output>
          <button type="button" data-party="1" aria-label="One guest more">+</button>
        </div>
        <div class="party__dots" data-party-dots aria-hidden="true"></div>
        <span class="meta" data-party-note>
          {initialTable.party === 1 ? "One seat" : `${initialTable.party} seats`} · their own listing says
          Ksh 1,000–2,000 a head
        </span>
      </div>
      <!-- hidden in the server HTML because partyAdvice() answers null for the common case (a party
           that divides evenly); render() un-hides it when there is something to say. Without this the
           empty slot keeps its dashed border and occupies grid space on first paint, and with JS off it
           stays an empty box forever. -->
      <p class="meta" data-advice hidden>{initial.count ? partyAdvice(initial, initialTable.party) ?? "" : ""}</p>
    </section>

    <section class="panel" style="padding:1.1rem">
      <h2 class="display--h3" id="when-label">When you fancy it</h2>
      <div class="explorer__tools" role="group" aria-labelledby="when-label">
        <label class="field">
          <span class="dim">Day</span>
          <input type="date" data-when-day />
        </label>
        <label class="field">
          <span class="dim">Time</span>
          <select data-when-time aria-label="Time, in half-hour slots they are open">
            {uniqueSlots.map((slot) => <option value={slot}>{slot}</option>)}
          </select>
        </label>
      </div>
      <p class="meta">
        They are open {f.hoursOfRecord.open}–{f.hoursOfRecord.close} every day, {change.label} at the moment you loaded this
        page. Choosing a slot here does not reserve it — it tells the floor staff what you want.
      </p>
    </section>

    <section>
      <div class="section-head">
        <h2 class="display--h2" data-kin>Start from the house set</h2>
        <span class="meta">{signatures.length} rows the restaurant is known for</span>
      </div>
      <div class="deck deck--wide">
        {
          signatures.map((item) => (
            <article class="card" data-card={item.id}>
              <div class="card__row">
                <h3 class="card__name">{item.name}</h3>
                <p class="card__price">{money(item.price)}</p>
              </div>
              <p class="card__desc">{item.signatureRole}</p>
              <div class="card__foot">
                <button
                  type="button"
                  class="btn btn--small btn--ghost"
                  data-add={item.id}
                  aria-label={`Add ${item.name} to your table`}
                >
                  Add
                </button>
                <a class="link-arrow" href={`/menu#${item.section}`}>see the section</a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="row-wrap" style="margin-top:1rem">
        <button type="button" class="btn btn--ghost" data-add-all>Put the whole house set on the table</button>
      </div>
    </section>
  </div>

  <aside class="sheet panel" aria-label="Your table">
    <h2 class="display--h3">Your table</h2>

    <ol class="sheet__lines" data-lines></ol>

    <p class="empty-note" data-empty>
      Nothing on it yet. Add anything from this page or from <a class="link-arrow" href="/menu">the full menu</a> —
      it stays here between visits, on this device, until you empty it.
    </p>

    <div class="sheet__total">
      <span>Estimated</span>
      <b data-total>{money(initial.subtotal)}</b>
    </div>
    <p class="meta" data-breakdown>
      {initial.count
        ? `${initial.count} plates · ${money(initial.perPerson)} a head across ${initialTable.party}`
        : "No plates yet."}
    </p>
    <p class="meta warn" data-unavailable hidden></p>

    <div class="stack" style="margin-top:0.4rem">
      <!-- The href the server prints is the plain "message the restaurant" link, and the script replaces it
           with the one carrying the table as soon as there is a table to carry. It used to be
           `initial.count ? "#" : "#"` — both arms the same value, so a guest with JavaScript switched off
           got a link that jumped to the top of the page instead of a way to book. -->
      <a class="btn btn--wide" data-whatsapp data-magnetic="0.3" href={`https://wa.me/${f.whatsapp}`}>Send it on WhatsApp</a>
      <div class="row-wrap">
        <button type="button" class="btn btn--small btn--ghost" data-copy-link>Copy this table as a link</button>
        <button type="button" class="btn btn--small btn--ghost" data-clear>Empty the table</button>
      </div>
      <p class="meta" data-copy-state aria-live="polite"></p>

      <!-- The sheet is a wish-list; this is the part that writes. The fields below are the only thing the
           guest has to supply — the lines, the party and the When pair already exist on this page, so the
           payload is assembled from the sheet's own state (lib/request-client.mjs `tablePayload`) rather than
           from a second copy of the form. Same reason /visit's form works: the book reprices everything, so
           what arrives is the kitchen's total, and the number on this screen travels only as a claim.

           The button is a network call, so the form is a JavaScript control. Left visible with the script off
           it would accept a submit that goes nowhere — a GET reload with the guest's name in the address bar —
           which is worse than no form, so `html:not(.js)` hides it and the note below says what to do instead.
           Same rule /visit applies to its request form. -->
      <noscript>
        <p class="meta dim">
          Recording a table needs JavaScript to reach the order book. Without it, the WhatsApp button above is
          the way in — it opens a message to the restaurant, and you are the one who sends it.
        </p>
      </noscript>
      <form class="stack" data-record-form data-wa={f.whatsapp} data-api={import.meta.env.PUBLIC_API_BASE} style="margin-top:0.7rem;padding-top:0.7rem;border-top:var(--edge)">
        <div class="field">
          <label for="tb-name">Name</label>
          <input id="tb-name" name="name" type="text" required autocomplete="name" maxlength="60" placeholder="Who the table is for" />
        </div>
        <div class="field">
          <label for="tb-phone">Phone</label>
          <input id="tb-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="20" placeholder="+254 7…" />
        </div>
        <div class="field">
          <label for="tb-notes">Anything they should know</label>
          <textarea id="tb-notes" name="notes" rows="2" maxlength="280" placeholder="A quiet corner, a birthday, a swap"></textarea>
        </div>
        <div class="row-wrap">
          <button class="btn btn--small" type="submit" data-record-send>Record this table</button>
          <a class="btn btn--small btn--ghost" href={`https://wa.me/${f.whatsapp}`} rel="noopener" target="_blank" data-handoff>Send it on WhatsApp with my details</a>
        </div>
        <!-- Three sentences, three lifetimes, and the reason they are not one element:
             · `data-record-hint` is the standing explanation, present in the server HTML so a guest with
               JavaScript off reads what the button does. The render pass rewrites it with the one thing that
               can be true after a record — that the sheet on screen is no longer the sheet that went in — so it
               holds only text the script may replace.
             · the phone line below it never changes and is never touched by the script, which is why the number
               and its `tel:` link survive every arm of the hint above. They used to live inside it, and the
               first rewrite deleted the link along with the sentence.
             · `data-record-state` is the live region, written only by a submit, so a guest tabulating through
               the sheet hears one sentence per action instead of a re-announcement every time a plate changes. -->
        <p class="meta dim" data-record-hint>
          This writes the sheet above into the kitchen's order book and reads back a reference. Nothing is sent
          until you press the button.
        </p>
        <p class="meta dim">
          A reference is not a confirmation — <a href={`tel:+${f.whatsapp}`}>{f.phone}</a> is the number that
          says yes.
        </p>
        <p class="meta dim" data-record-state role="status" aria-live="polite"></p>
      </form>
    </div>

    <p class="meta" style="margin-top:0.6rem">
      This is a wish-list, not a booking. "Send it on WhatsApp" carries the table only when you press it, and
      the message opens in your own app, so you are the one who sends it. Recording the sheet writes it into
      the order book and hands back a reference — still not a confirmation.
    </p>
  </aside>
</div>

<script>
  import menu from "../data/menu.json";
  import {
    EVENT,
    addToTable,
    changeOption,
    changeQty,
    clearTable,
    dropLine,
    getTable,
    getTotals,
    setParty,
    tableLink,
  } from "../lib/table-client.mjs";
  import { LINES_MAX, clampParty, findItem, money, partyAdvice, totals, whatsappText, whatsappUrl } from "../lib/table.mjs";
  import { firstBadControl, requestMessage, submitRequest, tablePayload, whatsAppHref } from "../lib/request-client.mjs";
  import { UTC_OFFSET_MINUTES, hourToLabel, nairobiHour } from "../lib/hours.mjs";
  import { component } from "../lib/page.mjs";

  // The builder redraws itself from the table on every change, so its one global subscription is the thing
  // that has to be released: two live builders would mean two renders per edit, and the second would be
  // writing into rows detached by the navigation that produced it.
  component("[data-builder]", { mount: wire, unmount: (stop) => stop?.() });

  function wire(builder: HTMLElement) {
    // The build-time origin is the fallback, not the answer. The link the floor staff open has to be the
    // table this guest was looking at, wherever this copy of the site happens to be served from — a
    // preview on a pages.dev subdomain must not hand the kitchen a URL for a domain nobody deployed.
    // (file:// gives "null" as an origin, which is why this checks the scheme rather than just truthiness.)
    const origin = /^https?:/.test(location.origin) ? location.origin : (builder.dataset.origin ?? "");
    const signatureIds = Array.from(builder.querySelectorAll<HTMLElement>("[data-add]")).map((n) => n.dataset.add ?? "");
    const linesEl = builder.querySelector<HTMLOListElement>("[data-lines]")!;
    const emptyEl = builder.querySelector<HTMLElement>("[data-empty]")!;
    const totalEl = builder.querySelector<HTMLElement>("[data-total]")!;
    const breakdownEl = builder.querySelector<HTMLElement>("[data-breakdown]")!;
    const unavailableEl = builder.querySelector<HTMLElement>("[data-unavailable]")!;
    const adviceEl = builder.querySelector<HTMLElement>("[data-advice]")!;
    const waEl = builder.querySelector<HTMLAnchorElement>("[data-whatsapp]")!;
    const partyCountEl = builder.querySelector<HTMLElement>("[data-party-count]")!;
    const partyNoteEl = builder.querySelector<HTMLElement>("[data-party-note]")!;
    const dotsEl = builder.querySelector<HTMLElement>("[data-party-dots]")!;
    const dayEl = builder.querySelector<HTMLInputElement>("[data-when-day]")!;
    const timeEl = builder.querySelector<HTMLSelectElement>("[data-when-time]")!;
    const copyStateEl = builder.querySelector<HTMLElement>("[data-copy-state]")!;
    const recordForm = builder.querySelector<HTMLFormElement>("[data-record-form]")!;
    const recordSend = builder.querySelector<HTMLButtonElement>("[data-record-send]")!;
    const recordState = builder.querySelector<HTMLElement>("[data-record-state]")!;
    const recordHint = builder.querySelector<HTMLElement>("[data-record-hint]")!;
    const handoffEl = builder.querySelector<HTMLAnchorElement>("[data-handoff]")!;

    // Today in Nairobi, not today on the laptop: a guest in Dubai picking "yesterday" because their
    // clock is two hours behind is a bug the site can simply refuse to have.
    const nairobiToday = () => {
      const utc = Date.now() + new Date().getTimezoneOffset() * 60_000;
      return new Date(utc + UTC_OFFSET_MINUTES * 60_000);
    };
    if (!dayEl.value) {
      const t = nairobiToday();
      dayEl.value = `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, "0")}-${String(t.getDate()).padStart(2, "0")}`;
      dayEl.min = dayEl.value;
    }
    // Land on the next half-hour they are open, so the default is something a guest could actually use.
    const pickDefaultSlot = () => {
      const now = nairobiHour();
      const next = Math.max(6.5, Math.min(22.5, Math.ceil((now + 0.5) * 2) / 2));
      const label = hourToLabel(next);
      if (Array.from(timeEl.options).some((o) => o.value === label)) timeEl.value = label;
    };
    pickDefaultSlot();

    const whenLabel = () => {
      const date = dayEl.value ? new Date(`${dayEl.value}T12:00:00Z`) : null;
      const day = date
        ? date.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" })
        : "Today";
      return `${day}, ${timeEl.value}`;
    };

    /* ---------------- the rows ---------------- */

    const rowFor = (row: ReturnType<typeof totals>["rows"][number]) => {
      const item = findItem(menu, row.id);
      const li = document.createElement("li");
      li.className = "line";
      li.dataset.key = row.key;

      const name = document.createElement("div");
      name.className = "line__name";
      const bold = document.createElement("b");
      bold.textContent = row.name;
      const note = document.createElement("span");
      note.textContent = `${money(row.unit)} × ${row.qty}${row.unavailable ? " · showing unavailable" : ""}`;
      if (row.unavailable) note.className = "warn";
      name.append(bold, note);
      li.append(name);

      const stepper = document.createElement("div");
      stepper.className = "stepper";
      const minus = document.createElement("button");
      minus.type = "button";
      minus.textContent = "−";
      minus.dataset.dec = row.key;
      minus.setAttribute("aria-label", `One fewer ${row.name}`);
      const out = document.createElement("output");
      out.textContent = String(row.qty);
      out.className = "num";
      const plus = document.createElement("button");
      plus.type = "button";
      plus.textContent = "+";
      plus.dataset.inc = row.key;
      plus.setAttribute("aria-label", `One more ${row.name}`);
      stepper.append(minus, out, plus);
      li.append(stepper);

      const kill = document.createElement("button");
      kill.type = "button";
      kill.className = "line__kill";
      kill.textContent = "×";
      kill.dataset.drop = row.key;
      kill.setAttribute("aria-label", `Remove ${row.name} from your table`);
      li.append(kill);

      // A dish with a chosen side gets its select inside the row, so the choice can be changed here
      // rather than by removing the line and going back to the menu to rebuild it.
      if (item?.accompaniments?.options?.length) {
        const wrap = document.createElement("label");
        wrap.className = "line__option";
        const text = document.createElement("span");
        text.className = "meta";
        text.textContent = "Side";
        const select = document.createElement("select");
        select.dataset.option = row.key;
        select.setAttribute("aria-label", `Accompaniment for ${row.name}`);
        for (const option of item.accompaniments.options) {
          const o = document.createElement("option");
          o.value = option;
          o.textContent = option;
          o.selected = option === row.option;
          select.append(o);
        }
        wrap.append(text, select);
        li.append(wrap);
      }
      return li;
    };

    const splitKey = (key: string) => {
      const at = key.indexOf("::");
      return at === -1 ? { id: key, option: undefined as string | undefined } : { id: key.slice(0, at), option: key.slice(at + 2) };
    };

    /* The record form's standing sentence lives in the markup, not here, so there is one copy of it and a
       guest with JavaScript off reads the same thing a guest with JavaScript does. These two variables are
       the only state the write path keeps: the identity of the sheet that went in, and the reference the book
       handed back for it. Both are compared against the sheet on screen, which is what lets the hint say
       "you have changed it since" instead of leaving a stale reference looking current. */
    const defaultHint = recordHint.textContent ?? "";
    let recordedKey = "";
    let recordedRef = "";

    /* The WhatsApp link the sheet has always had carries the dishes; this one carries the dishes *and* the
       name and number from the record form, which is what makes it the way through when the book cannot be
       reached. It is rebuilt on every render and on every keystroke in the form rather than only on a failed
       submit, because the sheet's own render pass owns the other WhatsApp anchor and would quietly drop the
       contact block the next time a plate changed hands. */
    const syncHandoff = () => {
      const sheet = getTable();
      const priced = getTotals();
      const payload = tablePayload(Object.fromEntries(new FormData(recordForm)), {
        table: sheet,
        claimed: priced.subtotal,
        day: dayEl.value,
        time: timeEl.value,
        when: whenLabel(),
        origin,
      });
      handoffEl.href = whatsAppHref(
        builder.dataset.phone ?? "",
        `${whatsappText(menu, sheet, whenLabel(), origin)}\n\n${requestMessage(payload)}`,
      );
    };

    const render = () => {
      const table = getTable();
      const t = totals(menu, table);
      linesEl.textContent = "";
      for (const row of t.rows) linesEl.append(rowFor(row));
      emptyEl.hidden = t.rows.length > 0;
      totalEl.textContent = money(t.subtotal);
      breakdownEl.textContent = t.count
        ? `${t.count} plate${t.count === 1 ? "" : "s"} · ${money(t.perPerson)} a head across ${table.party}`
        : "No plates yet.";
      unavailableEl.hidden = t.unavailable === 0;
      unavailableEl.textContent = t.unavailable
        ? `${t.unavailable} of those rows are showing as unavailable on their own menu today. The kitchen can usually swap them — the message says so.`
        : "";
      const advice = partyAdvice(t, table.party);
      adviceEl.textContent = advice ?? "";
      adviceEl.hidden = !advice;
      partyCountEl.textContent = String(table.party);
      partyNoteEl.textContent = `${table.party === 1 ? "One seat" : `${table.party} seats`} · their own listing says Ksh 1,000–2,000 a head`;
      dotsEl.textContent = "";
      for (let i = 0; i < Math.min(table.party, 16); i += 1) {
        const dot = document.createElement("span");
        dot.className = "dot";
        dot.setAttribute("data-on", "");
        dotsEl.append(dot);
      }
      if (t.count) {
        waEl.href = whatsappUrl(menu, table, whenLabel(), origin);
        waEl.removeAttribute("aria-disabled");
        waEl.textContent = "Send it on WhatsApp";
      } else {
        waEl.href = "#";
        waEl.setAttribute("aria-disabled", "true");
        waEl.textContent = "Add something first";
      }
      /* Recording an empty sheet is a 422 about dishes, and a sheet with more rows than the book takes is a 422
         about a number nobody told the guest. Both are decided here, in the same place the sentence is written,
         so the button and its explanation can never disagree. The WhatsApp link stays live through the long one
         — it is a message, and a message has no row limit. */
      const overCap = t.lineCount > LINES_MAX;
      recordSend.disabled = t.count === 0 || overCap;
      const sheetKey = JSON.stringify(table.lines);
      recordHint.textContent = !t.count
        ? "Nothing on the sheet to record yet."
        : overCap
          ? `At most ${LINES_MAX} different dishes go into the book at once, and this sheet has ${t.lineCount}. Empty some off, or use WhatsApp above — that route has no cap.`
          : recordedKey && recordedKey !== sheetKey
            ? `You sent ${recordedRef}, and that one stays in the book. The sheet has changed since — press Record again to send what is on it now.`
            : defaultHint;
      // The house-set buttons on this very page say what they have already done, so pressing "Add"
      // twice is visibly two plates rather than a mystery.
      for (const id of signatureIds) {
        const button = builder.querySelector<HTMLElement>(`[data-add="${CSS.escape(id)}"]`);
        const row = t.rows.find((r) => r.id === id);
        if (button) button.textContent = row ? `On the table · ${row.qty}` : "Add";
      }
      syncHandoff();
    };

    document.addEventListener(EVENT, render);
    // Typing a name is not a table change, so no event fires for it — and the handoff link's message is
    // supposed to hold that name.
    recordForm.addEventListener("input", syncHandoff);

    /* ---------------- the controls ---------------- */

    linesEl.addEventListener("change", (event: Event) => {
      const select = (event.target as HTMLElement)?.closest?.<HTMLSelectElement>("[data-option]");
      if (!select) return;
      const { id, option } = splitKey(select.dataset.option ?? "");
      changeOption(id, option, select.value);
    });

    linesEl.addEventListener("click", (event: MouseEvent) => {
      const button = (event.target as HTMLElement)?.closest?.<HTMLElement>("[data-inc],[data-dec],[data-drop]");
      if (!button) return;
      const key = button.dataset.inc ?? button.dataset.dec ?? button.dataset.drop ?? "";
      const { id, option } = splitKey(key);
      const line = getTable().lines.find((l) => (l.option ? `${l.id}::${l.option}` : l.id) === key);
      if (!line) return;
      if (button.dataset.drop) dropLine(id, option);
      else changeQty(id, option, line.qty + (button.dataset.inc ? 1 : -1));
    });

    builder.addEventListener("click", (event: MouseEvent) => {
      const target = event.target as HTMLElement;
      const add = target?.closest?.<HTMLElement>("[data-add]");
      if (add) {
        addToTable(add.dataset.add ?? "");
        return;
      }
      const all = target?.closest?.("[data-add-all]");
      if (all) {
        for (const id of signatureIds) addToTable(id);
        return;
      }
      const party = target?.closest?.<HTMLElement>("[data-party]");
      if (party) {
        const delta = Number(party.dataset.party ?? 0);
        setParty(clampParty(getTable().party + delta));
        return;
      }
      const copy = target?.closest?.("[data-copy-link]");
      if (copy) {
        const link = tableLink();
        const done = (ok: boolean) => {
          copyStateEl.textContent = ok
            ? "Link copied — it opens this exact table on any device."
            : `Copy it manually: ${link}`;
        };
        if (navigator.clipboard?.writeText) navigator.clipboard.writeText(link).then(() => done(true), () => done(false));
        else done(false);
        return;
      }
      if (target?.closest?.("[data-clear]")) {
        clearTable();
        copyStateEl.textContent = "";
        return;
      }
      if (target?.closest?.("[data-whatsapp]") && waEl.getAttribute("aria-disabled") === "true") {
        event.preventDefault();
        copyStateEl.textContent = "Nothing to send yet — add a dish first.";
      }
    });

    dayEl.addEventListener("change", render);
    timeEl.addEventListener("change", render);

    /* ---------------- writing the sheet into the book ---------------- */

    recordForm.addEventListener("submit", async (event) => {
      /* Native validity runs before this handler (no `novalidate`), and that is the whole client-side check:
         name and phone are `required`, and the When pair this page builds is already clamped to the hours the
         render is standing on. Prices, the party ceiling and the phone format are the Worker's to refuse, so
         its 422 is the sentence the guest reads — lib/request-client.mjs explains why nothing is re-typed here. */
      event.preventDefault();
      const table = getTable();
      const priced = getTotals();
      /* The button is disabled in both of these states, so reaching here means the guest pressed Enter in a
         field. Saying it beats sending a request the book is certain to refuse. */
      if (!priced.count || priced.lineCount > LINES_MAX) {
        recordState.textContent = !priced.count
          ? "There is nothing on the sheet to record."
          : `The book takes ${LINES_MAX} different dishes at a time, and this sheet has ${priced.lineCount}.`;
        return;
      }
      const payload = tablePayload(Object.fromEntries(new FormData(recordForm)), {
        table,
        claimed: priced.subtotal,
        day: dayEl.value,
        time: timeEl.value,
        when: whenLabel(),
        origin,
      });

      recordSend.disabled = true;
      recordState.textContent = "Sending the sheet to the book…";
      const result = await submitRequest(recordForm.dataset.api, payload);
      recordSend.disabled = false;

      if (result.kind === "recorded") {
        recordedKey = JSON.stringify(table.lines);
        recordedRef = result.reference;
        const drift = result.priceDrift;
        // Three arms, because "the numbers matched" and "we never compared them" are different sentences, and
        // the guest is about to be quoted a total at the table. The server's figure is named as the one on the
        // record either way — the page's number is evidence of a gap, never an amount.
        recordState.textContent =
          drift && drift.deltaKes
            ? `Recorded as ${result.reference}. The kitchen's own price list makes it ${money(drift.serverKes)} — ${money(Math.abs(drift.deltaKes))} ${drift.deltaKes > 0 ? "more" : "less"} than this sheet said, and that gap is on the record with you. Nothing is confirmed: +${builder.dataset.phone} is who decides.`
            : drift
              ? `Recorded as ${result.reference} — ${money(result.totalKes)}, the same figure this sheet shows. Nothing is confirmed: +${builder.dataset.phone} is who decides.`
              : `Recorded as ${result.reference}. Nothing is confirmed: +${builder.dataset.phone} is who decides.`;
        render();
        return;
      }
      if (result.kind === "invalid") {
        recordState.textContent = result.messages.join(" ");
        // The sheet's own line controls are not named by index, so a `lines[0].qty` complaint has no field to
        // land on — `firstBadControl` (lib/request-client.mjs) skips what it cannot match instead of building a
        // selector out of a string the server owns.
        firstBadControl(result.fields, recordForm.elements)?.focus();
        return;
      }
      if (result.kind === "busy") {
        recordState.textContent = result.retryAfterSeconds
          ? `You just sent one of these. Give it ${result.retryAfterSeconds} seconds and press Record again — the sheet is still here.`
          : "You just sent one of these. Give it a moment and press Record again.";
        return;
      }
      /* Two failures, two sentences — the same rule /visit follows. `unreachable` is "nothing arrived";
         `failed` is "the book received it and wrote nothing", which is a different instruction to the guest:
         after a refusal the press-again is the book's own, and the sheet's estimate is still what the kitchen
         will argue about, whereas after a connection failure the sheet never left the device. Both keep the
         sheet untouched and both leave the handoff carrying the same lines — the dishes and the estimate from
         `whatsappText`, the name and number from `requestMessage` — so a failed write costs a guest one more
         press rather than the request. The handoff is kept in sync on every render, so it is already correct
         by the time anyone reads this sentence. */
      syncHandoff();
      const serverSaid = result.kind === "failed" && result.messages?.length ? ` It said: ${result.messages.join(" ")}` : "";
      recordState.textContent =
        result.kind === "failed"
          ? `The book answered, but it did not record this sheet and no reference was issued.${serverSaid} The link beside this button carries these dishes with your name and number — press Record again, or send it there and the kitchen gets the same thing.`
          : "The book could not be reached, so nothing was recorded and no reference was issued. The link beside " +
            "this button carries this sheet with your name and number — send it there and the kitchen gets the " +
            "same thing.";
    });

    render();

    // Subscribed by its own name so this is the same function object, and the rows, the party dots and the
    // WhatsApp link below are all children of `builder` — they leave with it and need nothing released here.
    return () => document.removeEventListener(EVENT, render);
  }
</script>

<style>
  /* The record form is a network control, so it belongs to the JavaScript page and not to the paper one.
     Hidden by the same rule /visit uses for its request form, with the <noscript> sentence above saying what
     to do instead — the WhatsApp anchor and the phone link are static markup and work either way. */
  :global(html:not(.js)) [data-record-form] {
    display: none;
  }
</style>
