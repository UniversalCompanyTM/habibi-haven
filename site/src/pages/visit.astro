---
// site/src/pages/visit.astro — where it is, when it is open, and what "open" is contested by.
//
// This page exists because the three hours claims upstream disagree, and a website that picked one
// silently would be editing reality. The hours of record are printed as the operating answer, and the
// two other numbers are printed next to them with where they came from — that is the difference
// between a fact and a claim (docs/ARCHITECTURE.md, Decision 11).
import Base from "../layouts/Base.astro";
import menu from "../data/menu.json";
import press from "../data/press.json";
import voice from "../data/voice.json";
import { OPEN_LABEL, CLOSE_LABEL, isOpen, nextChange } from "../lib/hours.mjs";
import SocialLinks from "../components/SocialLinks.astro";
import HoursClock from "../components/HoursClock.astro";

const f = menu.meta.facts;
const open = isOpen();
const change = nextChange();
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(f.mapsQuery)}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(f.mapsQuery)}`;

// Frames we hold, in the order a guest would walk them: street, door, courtyard, table.
const frames = [
  { src: "/brand/venue-facade-day.jpg", alt: "The façade on Koinange Street, in daylight", caption: "The door, in daylight." },
  { src: "/brand/venue-courtyard-arches.jpg", alt: "The courtyard arches and planting", caption: "The courtyard, where the planting is." },
  { src: "/brand/venue-terrace-table-city.jpg", alt: "A terrace table with the city behind it", caption: "A terrace table, and the CBD behind it." },
  { src: "/brand/venue-table-mid-meal.jpg", alt: "A table mid-meal", caption: "Mid-meal: goat, rice, and the second plate." },
];
---

<Base
  title="Visit — Koinange Street, Nairobi CBD"
  description={`Habibi Haven on Koinange Street, Nairobi CBD. Hours ${OPEN_LABEL}–${CLOSE_LABEL} daily (Africa/Nairobi), plus code ${f.plusCode}, ${f.phone}, and the two other hours claims upstream.`}
>
  <section class="stage stage--tight">
    <div class="shell">
      <p class="eyebrow">Arriving</p>
      <h1 class="display" data-kin>Find us on Koinange Street</h1>
      <p class="lede">
        {f.address}, plus code {f.plusCode}. Open {OPEN_LABEL}–{CLOSE_LABEL}, every day of the week,
        Africa/Nairobi — {open ? `open now, ${change.label.toLowerCase()}` : `closed now, ${change.label.toLowerCase()}`}.
      </p>
    </div>
  </section>

  <section class="stage stage--tight">
    <div class="shell grid-2">
      <dl class="facts">
        <div class="fact">
          <dt>Address</dt>
          <dd>{f.address}</dd>
        </div>
        <div class="fact">
          <dt>Plus code</dt>
          <dd class="num">{f.plusCode}</dd>
        </div>
        <div class="fact">
          <dt>Phone · WhatsApp</dt>
          <dd>
            <a href={`https://wa.me/${f.whatsapp}`} rel="noopener" target="_blank">{f.phone}</a>
          </dd>
        </div>
        <div class="fact">
          <dt>Hours of record</dt>
          <dd class="num">
            {OPEN_LABEL}–{CLOSE_LABEL} · {f.hoursOfRecord.days}
          </dd>
        </div>
        <div class="fact">
          <dt>Price per person</dt>
          <dd>{f.pricePerPerson}</dd>
        </div>
        <div class="fact">
          <dt>Halal</dt>
          <dd>The kitchen is halal; it is how they describe themselves.</dd>
        </div>
      </dl>

      <div class="stack">
        <div class="row-wrap">
          <a class="btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Open in Maps</a>
          <a class="btn btn--ghost" href={directions} target="_blank" rel="noopener noreferrer">Directions</a>
        </div>
        <p class="meta dim">
          Both links ask Google Maps to centre on “{f.mapsQuery}” rather than on a coordinate we
          invented. The pin you see is theirs.
        </p>

        <div class="panel stack" style="padding:1.1rem">
          <p class="eyebrow eyebrow--amber">The hours, all three of them</p>
          <ul class="threads">
            <li class="thread">
              <span class="thread__kind">Used</span>
              <b>{OPEN_LABEL}–{CLOSE_LABEL}</b>
              <span class="meta dim">Google Maps listing — what a diner checks</span>
            </li>
            {
              f.hoursDisagreements.map((d) => (
                <li class="thread">
                  <span class="thread__kind">Elsewhere</span>
                  <b>{d.value}</b>
                  <span class="meta dim">{d.where}</span>
                </li>
              ))
            }
          </ul>
          <p class="meta dim">
            The Uber Eats window is a delivery window, and that store is flagged currently unavailable,
            which is why it is not the site's answer. Asked and unanswered: whether the kitchen really
            starts at half six. It is in docs/OPEN-QUESTIONS.md as a question for the restaurant.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="stage">
    <div class="shell stack-lg">
      <header class="section-head">
        <div>
          <p class="eyebrow">The place</p>
          <h2 class="display--h2" data-kin>What the photographs show</h2>
        </div>
        <p class="meta dim">
          {press.gaps[1]} That is why these frames sit at their real size instead of being stretched
          across a viewport — a stock shot of a different restaurant would be a lie about a specific
          place.
        </p>
      </header>

      <div class="deck deck--wide">
        {
          frames.map((frame, i) => (
            <figure class="card lit-edge" data-reveal style={`--i:${i}`}>
              <span class="frame">
                <img
                  src={frame.src}
                  alt={frame.alt}
                  width="300"
                  height="225"
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
              <figcaption class="card__desc">{frame.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stage stage--tight">
    <div class="shell grid-2">
      <div class="stack">
        <p class="eyebrow">How they rate</p>
        {
          press.ratings.map((r) => (
            <div class="panel stack" style="padding:1rem">
              <div class="row-wrap">
                <b class="display--h3 num">{r.score}</b>
                <span class="meta">{r.panel} · {r.reviews} review{r.reviews === 1 ? "" : "s"}</span>
                {r.rank ? <span class="chip">{r.rank}</span> : null}
              </div>
              <p class="meta dim">{r.read}</p>
              {r.price ? <p class="meta">{r.price}</p> : null}
              {r.note ? <p class="meta warn">{r.note}</p> : null}
              <a class="link-arrow" href={r.url} target="_blank" rel="noopener noreferrer">
                {r.panel} listing
              </a>
            </div>
          ))
        }
        <p class="meta dim">
          Two panels at different depths, shown side by side and never averaged. The site quotes the
          numbers as they are, including the uncomfortable one.
        </p>
      </div>

      <div class="stack">
        <div class="panel">
          <HoursClock name="visit" />
        </div>
        <div class="panel stack" style="padding:1.1rem">
          <p class="eyebrow">Where else they are</p>
          <SocialLinks size="stack" />
          <p class="meta dim">
            Their own words: “{voice.captions[1]}” — from @habibi.haven, quoted rather than improved.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
