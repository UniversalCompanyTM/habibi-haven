---
// site/src/pages/visit.astro — where it is, when it is open, and what "open" is contested by.
//
// This page exists because the three hours claims upstream disagree, and a website that picked one
// silently would be editing reality. The hours of record are printed as the operating answer, and the
// two other numbers are printed next to them with where they came from — that is the difference
// between a fact and a claim (docs/ARCHITECTURE.md, Decision 11).
import Base from "../layouts/Base.astro";
import menu from "../data/menu.json";
import press from "../data/press.json";
import voice from "../data/voice.json";
import { OPEN_LABEL, CLOSE_LABEL, isOpen, nextChange } from "../lib/hours.mjs";
import SocialLinks from "../components/SocialLinks.astro";
import HoursClock from "../components/HoursClock.astro";

const f = menu.meta.facts;
const open = isOpen();
const change = nextChange();
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(f.mapsQuery)}`;
// The two links do different jobs now that a coordinate exists.
//
// "Open in Maps" searches by name and lands on the venue's listing — photos, reviews, the works.
// "Directions" is sent to the number pair instead, because a text search is a guess wearing the venue's
// name: it can drop someone at the wrong end of Koinange Street or on the cloud-kitchen listing, and the
// matcher decides which on the day. The destination here is the centre of the ~14 m cell that the
// restaurant's OWN published plus code denotes, and it is the same pair the JSON-LD publishes, so the page
// and the structured data cannot point two different ways. Provenance and its one-source weakness are
// printed under the buttons rather than hidden: docs/OPEN-QUESTIONS.md §9.
const pin = f.coordinates ? `${f.coordinates.latitude},${f.coordinates.longitude}` : null;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(pin ?? f.mapsQuery)}`;

// Frames we hold, in the order a guest would walk them: street, door, courtyard, table.
const frames = [
  { src: "/brand/venue-facade-day.jpg", alt: "The façade on Koinange Street, in daylight", caption: "The door, in daylight." },
  { src: "/brand/venue-courtyard-arches.jpg", alt: "The courtyard arches and planting", caption: "The courtyard, where the planting is." },
  { src: "/brand/venue-terrace-table-city.jpg", alt: "A terrace table with the city behind it", caption: "A terrace table, and the CBD behind it." },
  { src: "/brand/venue-table-mid-meal.jpg", alt: "A table mid-meal", caption: "Mid-meal: goat, rice, and the second plate." },
];
---

<Base
  title="Visit — Koinange Street, Nairobi CBD"
  description={`Habibi Haven on Koinange Street, Nairobi CBD. Hours ${OPEN_LABEL}–${CLOSE_LABEL} daily (Africa/Nairobi), plus code ${f.plusCode}, ${f.phone}, and the two other hours claims upstream.`}
>
  <section class="stage stage--tight">
    <div class="shell">
      <p class="eyebrow">Arriving</p>
      <h1 class="display" data-kin>Find us on Koinange Street</h1>
      <p class="lede">
        {f.address}, plus code {f.plusCode}. Open {OPEN_LABEL}–{CLOSE_LABEL}, every day of the week,
        Africa/Nairobi — {open ? `open now, ${change.label.toLowerCase()}` : `closed now, ${change.label.toLowerCase()}`}.
      </p>
    </div>
  </section>

  <section class="stage stage--tight">
    <div class="shell grid-2">
      <dl class="facts">
        <div class="fact">
          <dt>Address</dt>
          <dd>{f.address}</dd>
        </div>
        <div class="fact">
          <dt>Plus code</dt>
          <dd class="num">{f.plusCode}</dd>
        </div>
        {
          pin ? (
            <div class="fact">
              <dt>Coordinates</dt>
              <dd class="num">{pin}</dd>
            </div>
          ) : null
        }
        <div class="fact">
          <dt>Phone · WhatsApp</dt>
          <dd>
            <a href={`https://wa.me/${f.whatsapp}`} rel="noopener" target="_blank">{f.phone}</a>
          </dd>
        </div>
        <div class="fact">
          <dt>Hours of record</dt>
          <dd class="num">
            {OPEN_LABEL}–{CLOSE_LABEL} · {f.hoursOfRecord.days}
          </dd>
        </div>
        <div class="fact">
          <dt>Price per person</dt>
          <dd>{f.pricePerPerson}</dd>
        </div>
        <div class="fact">
          <dt>Halal</dt>
          <dd>The kitchen is halal; it is how they describe themselves.</dd>
        </div>
      </dl>

      <div class="stack">
        <div class="row-wrap">
          <a class="btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Open in Maps</a>
          <a class="btn btn--ghost" href={directions} target="_blank" rel="noopener noreferrer">Directions</a>
        </div>
        <p class="meta dim">
          Directions go to {pin} — the centre of the ~14 m cell that plus code {f.plusCode} names, decoded
          from the venue’s own listing and the same pair the structured data publishes. Habibi Haven has not
          confirmed it yet, so “Open in Maps” still searches the listing by name, which is where the photos
          and reviews live.
        </p>

        <div class="panel stack" style="padding:1.1rem">
          <p class="eyebrow eyebrow--amber">The hours, all three of them</p>
          <ul class="threads">
            <li class="thread">
              <span class="thread__kind">Used</span>
              <b>{OPEN_LABEL}–{CLOSE_LABEL}</b>
              <span class="meta dim">Google Maps listing — what a diner checks</span>
            </li>
            {
              f.hoursDisagreements.map((d) => (
                <li class="thread">
                  <span class="thread__kind">Elsewhere</span>
                  <b>{d.value}</b>
                  <span class="meta dim">{d.where}</span>
                </li>
              ))
            }
          </ul>
          <p class="meta dim">
            The Uber Eats window is a delivery window, and that store is flagged currently unavailable,
            which is why it is not the site's answer. Asked and unanswered: whether the kitchen really
            starts at half six. It is in docs/OPEN-QUESTIONS.md as a question for the restaurant.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="stage">
    <div class="shell stack-lg">
      <header class="section-head">
        <div>
          <p class="eyebrow">The place</p>
          <h2 class="display--h2" data-kin>What the photographs show</h2>
        </div>
        <p class="meta dim">
          {press.gaps[1]} That is why these frames sit at their real size instead of being stretched
          across a viewport — a stock shot of a different restaurant would be a lie about a specific
          place.
        </p>
      </header>

      <div class="deck deck--wide">
        {
          frames.map((frame, i) => (
            <figure class="card lit-edge" data-reveal style={`--i:${i}`}>
              <span class="frame">
                <img
                  src={frame.src}
                  alt={frame.alt}
                  width="300"
                  height="225"
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
              <figcaption class="card__desc">{frame.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stage stage--tight">
    <div class="shell grid-2">
      <div class="stack">
        <p class="eyebrow">How they rate</p>
        {
          press.ratings.map((r) => (
            <div class="panel stack" style="padding:1rem">
              <div class="row-wrap">
                <b class="display--h3 num">{r.score}</b>
                <span class="meta">{r.panel} · {r.reviews} review{r.reviews === 1 ? "" : "s"}</span>
                {r.rank ? <span class="chip">{r.rank}</span> : null}
              </div>
              <p class="meta dim">{r.read}</p>
              {r.price ? <p class="meta">{r.price}</p> : null}
              {r.note ? <p class="meta warn">{r.note}</p> : null}
              <a class="link-arrow" href={r.url} target="_blank" rel="noopener noreferrer">
                {r.panel} listing
              </a>
            </div>
          ))
        }
        <p class="meta dim">
          Two panels at different depths, shown side by side and never averaged. The site quotes the
          numbers as they are, including the uncomfortable one.
        </p>
      </div>

      <div class="stack">
        <div class="panel">
          <HoursClock name="visit" />
        </div>
        <div class="panel stack" style="padding:1.1rem">
          <p class="eyebrow">Where else they are</p>
          <SocialLinks size="stack" />
          <p class="meta dim">
            Their own words: “{voice.captions[1]}” — from @habibi.haven, quoted rather than improved.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="stage stage--tight" id="request">
    <div class="shell grid-2">
      <div class="stack">
        <h2 class="display--h2" data-kin>Ask for a table</h2>
        <p class="measure meta">
          This writes one request into the restaurant's own order book and reads back a reference. It is not a
          confirmation: {f.phone} is still the number that decides, and the kitchen has not yet agreed to watch
          the book — which is exactly the conversation this page is here to start.
        </p>
        <noscript>
          <p class="measure meta">
            The form needs JavaScript to reach the book. Without it, the two buttons below are the way in —
            WhatsApp opens with the restaurant's number, and the call is one tap.
          </p>
        </noscript>
        <div class="row-wrap">
          <a class="btn btn--ghost" href={`https://wa.me/${f.whatsapp}`} rel="noopener" target="_blank">Order on WhatsApp</a>
          <a class="btn btn--ghost" href={`tel:+${f.whatsapp}`}>Call {f.phone}</a>
        </div>
      </div>

      <form class="panel stack" data-request-form data-wa={f.whatsapp} data-api={import.meta.env.PUBLIC_API_BASE}>
        <div class="field">
          <label for="rq-name">Name</label>
          <input id="rq-name" name="name" type="text" required autocomplete="name" maxlength="60" placeholder="Who the table is for" />
        </div>
        <div class="field">
          <label for="rq-phone">Phone</label>
          <input id="rq-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="20" placeholder="+254 7…" />
        </div>
        <div class="field">
          <label for="rq-date">Date</label>
          <input id="rq-date" name="date" type="date" required />
        </div>
        <div class="field">
          <label for="rq-time">Time</label>
          <input id="rq-time" name="time" type="time" required min={OPEN_LABEL} max={CLOSE_LABEL} step="900" value="19:00" />
        </div>
        <div class="field">
          <label for="rq-party">How many</label>
          <input id="rq-party" name="party" type="number" required min="1" max="20" step="1" inputmode="numeric" value="2" />
        </div>
        <div class="field">
          <label for="rq-notes">Anything they should know</label>
          <textarea id="rq-notes" name="notes" rows="3" maxlength="280" placeholder="High chairs, a quiet corner, a birthday"></textarea>
        </div>
        <p class="meta dim" data-outcome role="status" aria-live="polite">
          The room shows {OPEN_LABEL}–{CLOSE_LABEL}. Anything outside that, the form will not let you send.
        </p>
        <div class="row-wrap">
          <button class="btn" type="submit" data-send>Send the request</button>
          <a class="btn btn--ghost" href={`https://wa.me/${f.whatsapp}`} rel="noopener" target="_blank" data-handoff>Send it on WhatsApp instead</a>
        </div>
      </form>
    </div>
  </section>

  <style>
    /* The book is a network call, so the form is a JavaScript control. Without it the fields would sit there
       accepting a submit that goes nowhere — the honest state is no form, and the <noscript> paragraph above
       saying why. The WhatsApp and call anchors beside it are static markup and work either way. */
    :global(html:not(.js)) [data-request-form] {
      display: none;
    }
  </style>

  <script>
    import { component } from "../lib/page.mjs";
    import { UTC_OFFSET_MINUTES, pad } from "../lib/hours.mjs";
    import { requestMessage, reservationPayload, submitRequest, whatsAppHref } from "../lib/request-client.mjs";

    /* Bound through the lifecycle primitive rather than at module scope: the router does not re-execute this
       module after a swap (lib/page.mjs), so a listener attached here would belong to the first /visit and
       never to the one on screen. */
    component("[data-request-form]", {
      mount(form) {
        const out = form.querySelector("[data-outcome]");
        const send = form.querySelector("[data-send]");
        const handoff = form.querySelector("[data-handoff]");
        const date = form.querySelector("[name=date]");

        // Today in Nairobi, derived from the offset the whole site shares — a build machine's midnight or a
        // guest's phone timezone must not move the earliest date the book will accept.
        const nairobi = new Date(Date.now() + UTC_OFFSET_MINUTES * 60_000);
        const today = `${nairobi.getUTCFullYear()}-${pad(nairobi.getUTCMonth() + 1)}-${pad(nairobi.getUTCDate())}`;
        date.min = today;
        if (!date.value) date.value = today;

        form.addEventListener("submit", async (event) => {
          // Native validity already ran (no `novalidate` here on purpose: `required`, `type=time` with
          // min/max, and `type=number` with min/max are the guest's instant answer, and the server's 422
          // stays the real one — lib/request-client.mjs explains why nothing else is checked here).
          event.preventDefault();
          const payload = reservationPayload(Object.fromEntries(new FormData(form)), { origin: location.origin });
          send.disabled = true;
          out.textContent = "Sending that to the book…";
          const result = await submitRequest(form.dataset.api, payload);
          send.disabled = false;

          if (result.kind === "recorded") {
            // `f.phone` is frontmatter and cannot reach this script (Astro compiles it as its own module), so
            // the number travels as a data attribute — the same one the WhatsApp handoff is built from.
            out.textContent = `Recorded as ${result.reference}. The kitchen has the request — +${form.dataset.wa} is still who decides, so call if the table matters.`;
            return;
          }
          if (result.kind === "invalid") {
            out.textContent = result.messages.join(" ");
            const first = result.fields.map((field) => form.querySelector(`[name=${field.split(".").pop()}]`)).find(Boolean);
            first?.focus();
            return;
          }
          if (result.kind === "busy") {
            out.textContent = result.retryAfterSeconds
              ? `That number has a request going in right now. Try again in ${result.retryAfterSeconds} seconds.`
              : "That number has a request going in right now. Give it a moment.";
            return;
          }
          // Unreachable or a server-side failure: the WhatsApp button beside the form now carries exactly
          // what the guest typed, so the request survives the network instead of vanishing into a spinner.
          handoff.href = whatsAppHref(form.dataset.wa, requestMessage(payload));
          out.textContent =
            "The book could not be reached from here, so nothing was recorded. The WhatsApp button beside " +
            "this form now carries everything you typed — send it there and it arrives the same.";
        });
      },
    });
  </script>
</Base>
