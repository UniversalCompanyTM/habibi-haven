---
// site/src/pages/index.astro — the arrival.
//
// Order of the page is the order of an evening: arriving, sitting, ordering, staying, coming back. It
// is not a hero/three-cards/testimonials template. Each section earns its place by answering a
// question a stranger actually has, and every number in it comes from the captured data rather than
// from a sentence I could have made up.
//
// The only copy that is ours is connective tissue ("the menu, by room"). Anything that sounds like
// an opinion is quoted with its source, because we have no press article to paraphrase and inventing
// one would be the kind of polish that turns a fact into a claim.
import Base from "../layouts/Base.astro";
import menu from "../data/menu.json";
import press from "../data/press.json";
import voice from "../data/voice.json";
import { signatureItems, money } from "../lib/table.mjs";
import { OPEN_LABEL, CLOSE_LABEL, nairobiHour, isOpen } from "../lib/hours.mjs";
import HoursClock from "../components/HoursClock.astro";
import SocialLinks from "../components/SocialLinks.astro";
import DishCard from "../components/DishCard.astro";
import DoorScene from "../components/DoorScene.astro";

const f = menu.meta.facts;
const signatures = signatureItems(menu);
const open = isOpen();
const hour = nairobiHour();

// The four rooms the photographs actually show. Names are ours; the frames are theirs.
const rooms = [
  {
    src: "/brand/venue-courtyard-arches.jpg",
    alt: "The courtyard: arches, planting and tables between them",
    name: "The courtyard",
    note: "Where the afternoon goes slowly, under the arches and the planting.",
  },
  {
    src: "/brand/venue-terrace-seating.jpg",
    alt: "The terrace: outdoor tables with the city behind them",
    name: "The terrace",
    note: "First to fill at lunch, and the one with the view of Koinange Street.",
  },
  {
    src: "/brand/venue-interior-teal-sofa.jpg",
    alt: "The interior: teal banquettes and low light",
    name: "The room",
    note: "Banquettes, teal, and the light the dial on this page is set from.",
  },
  {
    src: "/brand/venue-facade-day.jpg",
    alt: "The façade in daylight",
    name: "The door",
    note: `On Koinange Street, Nairobi CBD — plus code ${f.plusCode}.`,
  },
];
---

<Base loader title="Habibi Haven — goat mandy and a garden courtyard on Koinange Street">
  {/* ---------------------------------------------------------------- arrival */}
  <section class="hero">
    <div class="hero__scene" data-scene aria-hidden="true">
      {/* The still is the renderer of record and stays at every tier; the door is a transparent canvas
          laid over it, so `2d` and `poster` differ from `full` by motion, never by missing content. */}
      <div
        class="hero__still"
        style={`background-image: url('/brand/venue-facade-night.jpg')`}
      ></div>
      <DoorScene position={[0, 1.62, 9.4]} target={[0, 1.78, -3.2]} fov={38} parallax />
    </div>

    <div class="shell hero__body">
      <p class="eyebrow eyebrow--amber">
        {f.address} · {open ? "Open now" : "Closed"} · {OPEN_LABEL}–{CLOSE_LABEL} EAT
      </p>
      <h1 class="display ink-sweep" data-kin>
        A haven is not a place you pass through. It is a place you stay too long.
      </h1>
      <p class="lede">
        Habibi Haven is a modern halal kitchen on Koinange Street — Somali and Coastal cooking, goat
        mandy from midday, karak chai from {OPEN_LABEL}. {menu.meta.items} dishes and drinks, priced
        straight from the kitchen's own menu data, median {money(menu.meta.median)}.
      </p>
      <div class="hero__actions">
        <a class="btn" href="/table" data-magnetic="0.3">Set your table</a>
        <a class="btn btn--ghost" href="/menu" data-magnetic="0.18">Read the menu</a>
        <a class="btn btn--ghost" href={f.socials.order} target="_blank" rel="noopener noreferrer">
          Order for delivery
        </a>
      </div>
    </div>

    <div class="hero__aside">
      <HoursClock minimal name="hero" />
      <p class="meta dim">Their words, not ours: “{voice.captions[0]}”</p>
    </div>
  </section>

  {/* ---------------------------------------------------------------- sitting */}
  <section class="stage">
    <div class="shell stack-lg">
      <header class="section-head">
        <div>
          <p class="eyebrow">Sitting</p>
          <h2 class="display--h2" data-kin>Three places to sit, and none of them rush you</h2>
        </div>
        <p class="meta dim">
          Photographs from the restaurant's own listings. {menu.meta.placeholderPhotos} of the
          {menu.meta.items} menu rows still have no picture upstream, and this page says so rather
          than buying one.
        </p>
      </header>

      <div class="deck deck--wide">
        {
          rooms.map((room, i) => (
            <article class="card lit-edge" data-reveal style={`--i:${i}`}>
              <span class="frame">
                <img
                  src={room.src}
                  alt={room.alt}
                  width="300"
                  height="225"
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
              <h3 class="card__name">{room.name}</h3>
              <p class="card__desc">{room.note}</p>
            </article>
          ))
        }
      </div>

      <div class="grid-2">
        <div class="quote">
          <p>{press.positioning[1].line}</p>
          <cite>
            — {press.positioning[1].source}. Their own description, quoted, not rewritten.
          </cite>
        </div>
        <div class="measure">
          <p>
            The other line they use is in the Instagram bio: <span class="script">“{press.positioning[2].line}”</span>.
          </p>
          <p class="meta dim">
            Both are kept verbatim. When a site paraphrases a business it starts sounding like a
            marketing agency, and this one is a restaurant with a garden.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  {/* ---------------------------------------------------------------- ordering */}
  <section class="stage stage--tight">
    <div class="shell stack-lg">
      <header class="section-head">
        <div>
          <p class="eyebrow">Ordering</p>
          <h2 class="display--h2" data-kin>The six the kitchen leads with</h2>
        </div>
        <p class="meta dim">
          Marked as signature in their own menu data, in the order they are listed there — not our
          shortlist.
        </p>
      </header>

      <div class="deck">
        {
          signatures.map((item, i) => (
            <DishCard item={item} priority={i < 3} />
          ))
        }
      </div>

      <p class="row-wrap">
        <a class="btn btn--ghost" href="/menu">
          The other {menu.meta.items - signatures.length} items, by room
        </a>
        <span class="meta dim">
          {menu.meta.families} rooms · {menu.meta.sections} sections · {menu.meta.realPhotos} with a
          photograph
        </span>
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------- the dial */}
  <section class="stage" id="the-day">
    <div class="shell grid-2">
      <div class="stack">
        <p class="eyebrow">The light rig</p>
        <h2 class="display--h2" data-kin>The room, at any hour you like</h2>
        <p class="lede">
          The palette on this site is a clock. It is built from the Nairobi hour at build time, and the
          dial writes the same two numbers every lit surface reads — so dragging it is not a theme
          switch, it is the same rig the page arrived on, dialled.
        </p>
        <dl class="facts">
          {
            [
              ["Hours of record", `${OPEN_LABEL}–${CLOSE_LABEL}, ${f.hoursOfRecord.days}`],
              ["Zone", f.hoursOfRecord.zone],
              [
                "Median dish",
                money(menu.meta.median),
              ],
              ["Price per person", f.pricePerPerson],
            ].map(([k, v]) => (
              <div class="fact">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="meta dim">
          Two other hours exist upstream and are not smoothed over:{" "}
          {f.hoursDisagreements.map((d) => `${d.value} (${d.where})`).join("; ")}.
        </p>
      </div>

      <div class="panel">
        <HoursClock name="day" />
      </div>
    </div>
  </section>

  <hr class="rule" />

  {/* ---------------------------------------------------------------- staying */}
  <section class="stage">
    <div class="shell stack-lg">
      <header class="section-head">
        <div>
          <p class="eyebrow">Staying</p>
          <h2 class="display--h2" data-kin>541 reviews, and the same things keep coming up</h2>
        </div>
        <p class="meta dim">Two panels, shown side by side, never averaged into one number.</p>
      </header>

      <div class="grid-2">
        <div class="stack">
          {
            press.ratings.map((r) => (
              <article class="card lit-edge stack">
                <div class="row-wrap">
                  <b class="display--h3 num">{r.score}</b>
                  <span class="meta">
                    {r.panel} · {r.reviews} review{r.reviews === 1 ? "" : "s"}
                  </span>
                  {r.rank ? <span class="chip">{r.rank}</span> : null}
                </div>
                <p class="meta dim">{r.read}</p>
                {r.price ? <p class="meta">{r.price}</p> : null}
                {r.note ? <p class="meta warn">{r.note}</p> : null}
                <a class="link-arrow" href={r.url} target="_blank" rel="noopener noreferrer">
                  Read it on {r.panel}
                </a>
              </article>
            ))
          }
        </div>

        <div class="stack">
          <p class="eyebrow eyebrow--amber">What diners name</p>
          <ul class="threads">
            {
              press.themes.map((t) => (
                <li class="thread">
                  <span class="thread__kind">{t.panel}</span>
                  <b>{t.theme}</b>
                  <span class="meta num">{t.mentions} mentions</span>
                </li>
              ))
            }
          </ul>

          <p class="eyebrow">Outside clips, linked not hosted</p>
          <ul class="threads">
            {
              press.coverage.map((c) => (
                <li>
                  <a class="thread" href={c.url} target="_blank" rel="noopener noreferrer">
                    <span class="thread__kind">{c.kind}</span>
                    <b>{c.title}</b>
                    <span class="meta dim">{c.by}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="meta dim">
            {press.coverage[0].how} Nothing here is re-hosted: the clips belong to the people who
            filmed them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  {/* ---------------------------------------------------------------- coming back */}
  <section class="stage stage--tight">
    <div class="shell grid-2">
      <div class="stack">
        <p class="eyebrow">Coming back</p>
        <h2 class="display--h2" data-kin>Come for the lamb chops. Stay for the third cup of chai.</h2>
        <p class="lede">
          The table you build on this site is a wish-list, not a booking — nothing here has a
          reservation system behind it. You send it to the number the restaurant already answers, and
          the floor staff reply as they always have.
        </p>
        <div class="row-wrap">
          <a class="btn" href="/table" data-magnetic="0.3">Build a table</a>
          <a class="btn btn--ghost" data-magnetic="0.18" href={`https://wa.me/${f.whatsapp}`} target="_blank" rel="noopener noreferrer">
            {f.phone}
          </a>
        </div>
      </div>

      <div class="panel stack">
        <p class="eyebrow">Where else they are</p>
        <SocialLinks size="stack" />
        <p class="meta dim">
          Captured {menu.meta.capturedAt.slice(0, 10)} from the live sources. Menu fingerprint{" "}
          <span class="num">{menu.meta.sourceFingerprint}</span>.
        </p>
      </div>
    </div>
  </section>
</Base>
