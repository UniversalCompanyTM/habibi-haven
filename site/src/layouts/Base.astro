---
// site/src/layouts/Base.astro — head, rig, chrome.
//
// The hour is computed at build time, not on first paint: `--hour` and `--night` go onto the `<html>`
// style attribute from lib/hours.mjs, so the room is already lit for the right time of day in the
// server HTML, and the WebGL door reads those same two numbers rather than a copy of them.
// hours.mjs applies the Nairobi offset as arithmetic, so a build machine in any timezone gets the
// same answer (tests/run.mjs pins it).
import menu from "../data/menu.json";
import { nairobiHour, rigFor } from "../lib/hours.mjs";
import { restaurantSchema } from "../lib/schema.mjs";
import "../styles/tokens.css";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

import Nav from "../components/Nav.astro";
import ActionDock from "../components/ActionDock.astro";
import Footer from "../components/Footer.astro";
import Ticker from "../components/Ticker.astro";
import Cursor from "../components/Cursor.astro";
import Preloader from "../components/Preloader.astro";

const props = Astro.props;
const f = menu.meta.facts;
const rig = rigFor(nairobiHour());
// The curtain is opt-in, because it is only polite in front of an entrance and only rude in front of
// a menu. Home sets `loader`; /menu, /table and /visit do not.
const loader = props.loader === true;

const ORIGIN = Astro.site ?? new URL("https://habibi-haven.example");
// The address this page publishes as canonical is the route, not the build's file name.
//
// During a static build Astro.url.pathname is the path of the file being written, and with
// build.format = "file" the /menu route is written as /menu.html. Measured on the hosted site
// 2026-11-15: taking the pathname at face value published `rel=canonical` as …/menu.html on four
// routes. That is not a duplicate page — Pages 308s …/menu.html back to /menu — but a canonical that
// names a redirect asks Google to index the address that only exists to move, and it is the one field
// on this page that is read by somebody other than a person. The extension is stripped here, and
// scripts/verify-dist.mjs now compares every page's canonical and og:url against the route it was
// built from, so the two can never disagree quietly again.
const path =
  Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(path, ORIGIN).href;

// Every factual claim in the block traces to research/BRAND-FACTS.md or research/PRESS.md — the same
// facts/ field the visible pages read, so a price cannot disagree with itself between the menu card and
// the answer Google gives about it. lib/schema.mjs is where the rules live; see that file for why the
// GPS field is implemented and still dark.
const jsonLd = restaurantSchema({
  menu,
  origin: ORIGIN.href,
  canonical,
  // "Coastal and Somali" is how their own TripAdvisor listing frames it, and the rating is Google's with
  // its count attached, because a schema rating without a source is fiction.
  description:
    "Habibi Haven is a modern halal restaurant on Koinange Street in Nairobi CBD — Coastal and Somali cooking, goat mandy, karak chai, and a garden courtyard that opens at 06:30.",
});

const title = props.title ?? "Habibi Haven — goat mandy and a garden courtyard on Koinange Street";
const description =
  props.description ??
  "Habibi Haven Restaurant, Koinange Street, Nairobi CBD. 243 dishes read straight from the kitchen's own data, karak chai from 06:30, and a table you can set before you arrive.";
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
---

<!doctype html>
<html lang="en" style={`--hour: ${rig.hour}; --night: ${rig.night.toFixed(3)}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={rig.night > 0.5 ? "#04100e" : "#f3f1ec"} />
    {
      /* A preview deploy is not the site. Until the client owns a domain, only an explicitly
         indexable build asks to be crawled. */
      indexable ? null : <meta name="robots" content="noindex, nofollow" />
    }

    {/* Inside the site, a click is a swap, not a reload.
        The pitch demo is a person walking a restaurant owner through Menu → Table → Visit on a phone, in
        a room with whatever signal a courtyard has. Every one of those clicks used to tear the document
        down and rebuild it: the white frame, the re-fetched fonts, the WebGL door re-initialising, the
        hour the guest just dialled reset to the build's clock. The router keeps one document and swaps its
        contents, which is the difference between a site that feels loaded and a site that is loading.

        Three things about how this is wired, because each is a place where a router quietly breaks a
        hand-built page:
        · The page change is animated, and not by anything we asked Astro for. With no `transition:animate`
          directive in the project the browser still paints its own ~0.25 s cross-fade between the two root
          snapshots, and the router does not stop it for anybody: `astro/dist/transitions/router.js`
          contains no `matchMedia` call, so nothing about that fade honours `prefers-reduced-motion` on
          its own. styles/global.css therefore declares the duration (180 ms) and switches it off under
          that media query, so the one piece of motion the router brings in is a number this project owns
          rather than a default it inherited. The arrival of content *inside* a page is still the existing
          `[data-reveal]` system, whose durations already collapse to 1 ms (styles/global.css:11) — that
          renderer is untouched by any of this.
        · The incoming page's own scripts deliberately do not re-execute (lib/page.mjs explains the
          `data-astro-exec` dedupe), so every live thing on a page is owned by the lifecycle primitive
          rather than by its module body. That is what makes this swap safe, and it is why this line has a
          dependency rather than being a one-line feature flag.
        · The two things the incoming `<html>` cannot know — that JavaScript runs here, and the hour this
          visitor dialled — are re-asserted on `astro:after-swap`, in the script block at the bottom of
          this file. Without that, the router would strip `html.js` on the first click and every reveal
          rule would drop out with it.
        A link that must really reload carries `data-astro-reload`; with JavaScript switched off none of
        this exists and the site behaves exactly as it did before the line was added. */}
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&display=swap"
    />
    <link rel="icon" type="image/jpeg" href="/brand/habibi-haven-badge.jpg" />
    <link rel="apple-touch-icon" href="/brand/habibi-haven-badge.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Habibi Haven" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/brand/venue-facade-night.jpg", ORIGIN).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body data-hour={rig.hour} data-night={rig.night.toFixed(3)}>
    <a class="skip-link" href="#main">Skip to content</a>
    {loader ? <Preloader /> : null}
    <Nav facts={f} rig={rig} current={path} overHero={path === "/"} />

    <main id="main">
      <slot />
    </main>

    <Ticker />
    <Footer />
    <ActionDock current={path} whatsapp={f.whatsapp} phone={f.phone} />
    <Cursor />
  </body>
</html>

<script>
  import { applyHour, liveHour } from "../lib/rig-client.mjs";
  import { component, onPage } from "../lib/page.mjs";

  /* Reveal on scroll, once. Where IntersectionObserver is missing the fallback adds the class
     immediately rather than never, so the failure mode is "no animation", not "invisible content". */
  const seen = new WeakSet();
  const watched = [];
  const io =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              // Reveal on entry — and on first sample if the element is already fully ABOVE the
              // viewport. A jump (deep link to /menu#room, End key, restored scroll) never
              // intersects the sections it skipped, and a card whose only other state is
              // `opacity: 0` is copy the reader cannot get back without scrolling the whole way up.
              // When in doubt this fails toward showing the content, which is the correct direction
              // for a failure.
              if (!e.isIntersecting && e.boundingClientRect.bottom > 0) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
        )
      : null;

  /* The comment above promises the jump case is handled, and at load it is: the first sample reports
     every observed node, and the ones already above the fold are revealed there. It is not handled for
     a jump that happens LATER. An observer only calls back on a threshold crossing, and a section that
     used to be below you and is now far above you crosses nothing on the way past — End on /menu lands
     at 39,000 px and measures 41 of 251 revealed, with 243 dishes invisible above you. So the observer
     is not the only thing watching: on a displacement larger than a screen, sweep the registry and hand
     back everything the jump stepped over. Small scrolls keep their animation. */
  const showEverythingAbove = () => {
    for (let i = watched.length - 1; i >= 0; i -= 1) {
      const el = watched[i];
      if (el.getBoundingClientRect().bottom > 0) continue;
      el.classList.add("is-in");
      if (io) io.unobserve(el);
      watched.splice(i, 1);
    }
  };

  let lastY = scrollY;
  addEventListener(
    "scroll",
    () => {
      if (Math.abs(scrollY - lastY) > innerHeight * 1.5) showEverythingAbove();
      lastY = scrollY;
    },
    { passive: true }
  );
  addEventListener("pageshow", () => {
    // a restored scroll position from the back/forward cache produces no crossing either
    requestAnimationFrame(showEverythingAbove);
  });

  /* Headline words are lifted out of a mask one at a time. The split happens here instead of in the
     markup so an author writes one sentence, and so a disabled-JS page still has that sentence. */
  function kinify(el) {
    if (el.dataset.kin === "done") return;
    const words = (el.textContent ?? "").trim().split(/\s+/);
    el.textContent = "";
    el.classList.add("kin");
    words.forEach((word, i) => {
      const outer = document.createElement("span");
      const inner = document.createElement("span");
      inner.textContent = word;
      inner.style.setProperty("--i", String(Math.min(i, 11)));
      outer.append(inner);
      el.append(outer, " ");
    });
    el.dataset.kin = "done";
  }

  function prep(root = document) {
    root.querySelectorAll("[data-kin]").forEach(kinify);
    root.querySelectorAll("[data-reveal]").forEach((n, i) => {
      if (!n.style.getPropertyValue("--i")) n.style.setProperty("--i", String(i % 8));
    });
    const nodes = root.querySelectorAll("[data-reveal], .kin");
    if (!io) {
      nodes.forEach((n) => n.classList.add("is-in"));
      return;
    }
    nodes.forEach((n) => {
      if (!seen.has(n)) {
        seen.add(n);
        io.observe(n);
        watched.push(n);
      }
    });
  }

  /* Two things the server cannot know about a swapped-in document, re-asserted on every page.
     `html.js`: the inline script in <head> is keyed by its own text inside Astro's swap function, so after
     the first navigation it is marked as already run and never adds the class again — and every
     `[data-reveal]` and `.kin` on the incoming page then renders in the no-JavaScript state, which is
     visible but unmoved. And the hour this visitor dialled, which lives in lib/rig-client.mjs rather than
     in the build's HTML. The order relative to the components does not matter: `applyHour` fires `hh:hour`,
     and the door and the dials repaint from that event rather than from whatever they read at mount. */
  function reassert() {
    const root = document.documentElement;
    root.classList.add("js");
    const askedFor = liveHour();
    // Only repaint when the clock on the root actually disagrees with what this visitor dialled. The two
    // callers below mean this runs twice per navigation, and `applyHour` broadcasts `hh:hour` to the door
    // and to both dials — an unconditional second call would be a redundant repaint of the whole room for
    // one click.
    if (askedFor !== null && root.style.getPropertyValue("--hour") !== String(askedFor)) applyHour(askedFor);
  }

  // after-swap is the earliest moment the incoming document exists, and that is where this has to run:
  // swapRootAttributes (astro/dist/transitions/swap-functions.js) removes every attribute from the live
  // `<html>` and copies the incoming one's, so `html.js` is gone the instant the swap lands — and the
  // router then awaits its script imports before it fires page-load. Anything that paints inside that
  // window shows the incoming page in its no-JavaScript state and snaps it back a beat later. page-load
  // still runs the same function, which is what keeps it correct on a first arrival and with the router
  // switched off. The order relative to the components does not matter either way: the door and the dials
  // repaint from `hh:hour`, and a dial mounting after this reads the hour that is now on the root.
  document.addEventListener("astro:after-swap", reassert);

  onPage(() => {
    reassert();
    // A new page begins at its own scroll position. Carrying the old number over would make the first
    // scroll of the visit read as a jump and hand back every reveal above it before the guest has passed.
    lastY = scrollY;
    prep();
  });
  /* Islands (the menu explorer, the table builder) render after hydration and ask for a rescan. */
  document.addEventListener("hh:prep", () => prep(document));

  // The stuck-header test belongs to the element, not to the script. A `nav` captured at module scope points
  // at the header of whichever page loaded first, so after one navigation the handler would toggle
  // `data-stuck` on a node that left with the previous body while the one on screen never got its shadow.
  component(".nav", {
    mount(nav) {
      const onScroll = () => nav.toggleAttribute("data-stuck", window.scrollY > 24);
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });
      return () => removeEventListener("scroll", onScroll);
    },
    unmount: (stop) => stop?.(),
  });

  /* One shared clock: the dial writes these two numbers, CSS interpolates the palette from --night,
     and the WebGL door reads the same pair off the document element. The writing itself lives in
     lib/rig-client.mjs so no second copy of the curve can exist — this file only exposes it as
     `window.hhSetHour` for anything that would rather call than import. */
  window.hhSetHour = applyHour;
</script>
